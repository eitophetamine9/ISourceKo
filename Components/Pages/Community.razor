@page "/community"
@rendermode InteractiveServer
@inject IStudentSubmissionService SubmissionService

<PageTitle>Student Notes & Peer Sources - ISourceKO</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- Header with CTA -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold mb-2 border border-emerald-200/80">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Student-Powered Community Hub
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                Peer-Submitted Study Sources
            </h1>
            <p class="text-sm text-slate-600 mt-1 max-w-xl">
                Explore handwritten notes, diagrams, formula summaries, and high-yield study links uploaded directly by students.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-150">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Upload Note or Link</span>
            </a>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="mt-6 p-4 bg-white rounded-2xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Search Keyword -->
        <div class="relative flex-1">
            <input @bind="filterQuery"
                   @bind:event="oninput"
                   @bind:after="ApplyFilters"
                   type="text"
                   placeholder="Filter peer notes by keyword, tag, or student..."
                   class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-wrap items-center gap-2">
            <!-- Type Pill Buttons -->
            <button type="button"
                    @onclick="() => FilterByType(null)"
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors @(selectedType == null ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                All Types
            </button>
            <button type="button"
                    @onclick="() => FilterByType(SubmissionType.ImageNote)"
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors @(selectedType == SubmissionType.ImageNote ? "bg-emerald-600 text-white" : "bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200/50")">
                📷 Photos & Notes
            </button>
            <button type="button"
                    @onclick="() => FilterByType(SubmissionType.Link)"
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors @(selectedType == SubmissionType.Link ? "bg-indigo-600 text-white" : "bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200/50")">
                🔗 Helpful Links
            </button>

            <!-- Discipline Filter -->
            <select @bind="selectedField" @bind:after="ApplyFilters" class="py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="@AcademicField.General">All Disciplines</option>
                <option value="@AcademicField.ComputerScience">Computer Science</option>
                <option value="@AcademicField.NaturalSciences">Natural Sciences</option>
                <option value="@AcademicField.Mathematics">Mathematics</option>
                <option value="@AcademicField.Engineering">Engineering</option>
                <option value="@AcademicField.MedicineAndHealth">Medicine & Health</option>
            </select>

            <!-- Sort By -->
            <select @bind="sortBy" @bind:after="ApplyFilters" class="py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="newest">Newest First</option>
                <option value="top">Most Upvoted</option>
                <option value="comments">Most Active</option>
            </select>
        </div>
    </div>

    <!-- Submissions Cards Grid -->
    <div class="mt-8">
        @if (isLoading)
        {
            <LoadingSkeleton Count="6" />
        }
        else if (submissions.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var submission in submissions)
                {
                    <StudentSourceCard Submission="submission" OnViewImage="OpenImageModal" />
                }
            </div>
        }
        else
        {
            <EmptyState Title="No student submissions found" Message="Be the first to upload your handwritten study notes or recommend a great academic link!" />
        }
    </div>
</div>

<!-- Lightbox Modal for Student Images -->
<ImageModal ImageUrl="@activeModalImage" OnClose="CloseImageModal" />

@code {
    private List<StudentSubmission> submissions = new();
    private string filterQuery = string.Empty;
    private SubmissionType? selectedType = null;
    private AcademicField selectedField = AcademicField.General;
    private string sortBy = "newest";
    private bool isLoading = true;
    private string? activeModalImage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubmissions();
    }

    private async Task LoadSubmissions()
    {
        isLoading = true;
        try
        {
            submissions = await SubmissionService.GetSubmissionsAsync(
                query: filterQuery,
                field: selectedField == AcademicField.General ? null : selectedField,
                type: selectedType,
                sortBy: sortBy);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        await LoadSubmissions();
    }

    private async Task FilterByType(SubmissionType? type)
    {
        selectedType = type;
        await LoadSubmissions();
    }

    private void OpenImageModal(string imageUrl)
    {
        activeModalImage = imageUrl;
    }

    private void CloseImageModal()
    {
        activeModalImage = null;
    }
}
