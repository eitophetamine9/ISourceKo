@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col font-sans text-oxford transition-colors duration-200">
    <!-- Masthead Navbar -->
    <NavMenu />

    <!-- Main Content Area -->
    <main class="flex-1 pb-16">
        @Body
    </main>

    <!-- Collegiate Archive Footer -->
    <footer class="bg-white border-t border-oxford-200 mt-auto text-xs text-oxford-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="font-serif font-bold text-oxford-950 text-sm">ISourceKO</span>
                        <span class="text-oxford-300">/</span>
                        <span class="text-oxford-700">Academic Discovery & Peer Source Index</span>
                    </div>
                    <p class="text-oxford-500 text-[11px] max-w-md">
                        Cross-referencing video lectures, peer-reviewed journals, and student handwritten notes. Built on Blazor Web and Tailwind CSS.
                    </p>
                </div>

                <!-- Aggregated Corpi Badges -->
                <div class="flex flex-wrap items-center gap-4 text-[11px] font-medium text-oxford-700">
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-openalex"></span> OpenAlex</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-youtube"></span> YouTube Learning</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-sciencedirect"></span> ScienceDirect</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-scholar"></span> Semantic Scholar</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-evergreen"></span> Peer Submissions</span>
                </div>
            </div>
        </div>
    </footer>
</div>
