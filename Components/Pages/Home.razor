@page "/"
@rendermode InteractiveServer
@inject ISourceAggregatorService AggregatorService

<PageTitle>ISourceKO — Academic Discovery Across Literature, Lectures & Notes</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Hero Section with Staggered Masked Text Reveal & Scale-Down Media -->
    <header class="relative text-center max-w-3xl mx-auto mb-10 py-8 px-5 rounded-2xl hero-blueprint border border-oxford-200/60 bg-white/50 shadow-subtle hero-media-scale overflow-hidden">
        <!-- Masked Reveal Line 1: Badge -->
        <div class="overflow-hidden">
            <span class="masked-line-inner inline-flex items-center gap-2 px-3 py-1 rounded text-xs font-bold bg-oxford-950 text-bone shadow-subtle mb-3 will-change-transform">
                <span class="w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
                Unified Collegiate Research Engine
            </span>
        </div>
        
        <!-- Masked Reveal Line 2: Headline Part 1 -->
        <div class="overflow-hidden">
            <h1 class="masked-line-inner font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-oxford-950 tracking-tight leading-[1.12] will-change-transform">
                One Search Across Scholarly Papers,
            </h1>
        </div>
        
        <!-- Masked Reveal Line 3: Headline Part 2 -->
        <div class="overflow-hidden">
            <h1 class="masked-line-inner font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-oxford-950 tracking-tight leading-[1.12] text-oxford-800 will-change-transform">
                Lecture Videos, and Student Notes
            </h1>
        </div>
        
        <!-- Masked Reveal Line 4: Body Description -->
        <div class="overflow-hidden mt-3">
            <p class="masked-line-inner text-xs sm:text-sm text-oxford-600 max-w-2xl mx-auto leading-relaxed will-change-transform">
                Consolidate your course research. Query ScienceDirect peer-reviewed articles, YouTube academic lectures, Semantic Scholar citations, and student handwritten guides in a single pass.
            </p>
        </div>
    </header>

    <!-- Interactive Search Desk (With Magnetic Action Button) -->
    <section class="max-w-4xl mx-auto mb-10" aria-label="Search form">
        <SearchBar Query="searchQuery" TrendingTopics="trendingTopics" OnSearch="PerformSearch" />
    </section>

    <!-- Kinetic Marquee: Reacts to User's Scroll Velocity & Direction -->
    <section class="w-full overflow-hidden py-3 border-y border-oxford-200/70 bg-white/70 backdrop-blur-sm my-8 select-none" aria-hidden="true">
        <div class="kinetic-marquee-track flex whitespace-nowrap will-change-transform text-[11px] font-mono font-bold tracking-widest text-oxford-600 uppercase">
            <span>YOUTUBE OPENCOURSEWARE + LECTURES &nbsp;•&nbsp; SCIENCEDIRECT PEER-REVIEWED JOURNAL ARTICLES &nbsp;•&nbsp; SEMANTIC SCHOLAR CITATION GRAPH &nbsp;•&nbsp; STUDENT HANDWRITTEN EXAM NOTES &nbsp;•&nbsp; DOI CITATION EXPORTS &nbsp;•&nbsp; OPEN ACCESS REPOSITORIES &nbsp;•&nbsp; </span>
            <span>YOUTUBE OPENCOURSEWARE + LECTURES &nbsp;•&nbsp; SCIENCEDIRECT PEER-REVIEWED JOURNAL ARTICLES &nbsp;•&nbsp; SEMANTIC SCHOLAR CITATION GRAPH &nbsp;•&nbsp; STUDENT HANDWRITTEN EXAM NOTES &nbsp;•&nbsp; DOI CITATION EXPORTS &nbsp;•&nbsp; OPEN ACCESS REPOSITORIES &nbsp;•&nbsp; </span>
        </div>
    </section>

    <!-- Results Section (Dynamic Animated Flow) -->
    <section class="max-w-7xl mx-auto reveal-on-scroll" aria-live="polite">
        @if (isLoading)
        {
            <div class="py-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-2 text-xs text-oxford-600 font-mono font-medium">
                        <span class="w-2 h-2 rounded-full bg-flame animate-ping"></span>
                        Executing parallel queries across registered academic corpora...
                    </span>
                </div>
                <LoadingSkeleton Count="6" />
            </div>
        }
        else if (response != null && !string.IsNullOrWhiteSpace(response.Query))
        {
            <!-- Results Header & Counts with Pop Pills -->
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 pb-3 mb-6 border-b border-oxford-200">
                <div>
                    <h2 class="font-serif text-xl font-bold text-oxford-950">
                        Results for "<span class="text-oxford-900 italic font-semibold">@response.Query</span>"
                    </h2>
                    <p class="text-xs text-oxford-500 mt-0.5">
                        Retrieved <strong class="text-oxford-900 font-mono">@response.TotalResults</strong> entries in <strong class="text-flame font-mono">@(Math.Round(response.ElapsedTime.TotalMilliseconds))ms</strong> across @response.CountByPlatform.Count corpora
                    </p>
                </div>

                <!-- Platform Count Pills with Tactile Border -->
                <div class="flex flex-wrap items-center gap-2 text-xs">
                    @foreach (var kvp in response.CountByPlatform)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white border border-oxford-200 rounded shadow-subtle text-oxford-700 font-medium">
                            <PlatformBadge Platform="kvp.Key" />
                            <span class="font-mono font-bold text-oxford-900">@kvp.Value</span>
                        </span>
                    }
                </div>
            </div>

            @if (response.Items.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
                    @foreach (var item in response.Items)
                    {
                        <SourceCard Item="item" />
                    }
                </div>
            }
            else
            {
                <EmptyState Title="No indexed sources found" Message="Try searching with a broader topic keyword, or select 'All Sources' to include video lectures and student notes." />
            }
        }
        else
        {
            <!-- Scroll-Linked Sticky Split-Screen Section: How ISourceKO Works -->
            <div class="pt-8 pb-12 reveal-on-scroll">
                <div class="text-center mb-10">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-bold bg-oxford-100 text-oxford-800 uppercase tracking-wider mb-2">
                        System Architecture
                    </span>
                    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950">How ISourceKO Indexes Knowledge</h2>
                    <p class="text-xs sm:text-sm text-oxford-600 mt-1 max-w-lg mx-auto">
                        Scroll through the knowledge pipeline below to see how external APIs and student contributions synchronize in real-time.
                    </p>
                </div>

                <!-- Sticky Split Container (Desktop Pinned Parallax, Mobile Vertical Stack) -->
                <div class="sticky-split-container grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <!-- Left: Dynamic Sticky Visual Terminal/Display Container -->
                    <div class="lg:col-span-5 lg:sticky lg:top-24 bg-oxford-950 text-bone p-6 rounded-2xl shadow-lift border border-oxford-800 space-y-4">
                        <div class="flex items-center justify-between pb-3 border-b border-oxford-800 text-xs">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                <span class="font-mono text-oxford-400 text-[11px] ml-1">corpus_telemetry.log</span>
                            </div>
                            <span class="px-2 py-0.5 rounded bg-flame/20 text-flame font-mono text-[10px] font-bold">LIVE SYNC</span>
                        </div>

                        <!-- Panel 1: Video Stream State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-red-400">[01] YouTube Lecture Aggregation</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Filters educational channels (3Blue1Brown, MIT OCW, Stanford). Extracts video transcripts and high-yield chapters.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Latency: &lt;120ms</span>
                                    <span class="text-emerald-400">STATUS: 200 OK</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 2: Peer-Reviewed Elsevier/ScienceDirect State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-amber-400">[02] Elsevier / ScienceDirect DOI Graph</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Queries research abstracts, peer review badges, journal volumes, and formats auto-generated APA and BibTeX citations.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Citations Index: 4.8M+</span>
                                    <span class="text-emerald-400">STATUS: VERIFIED</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 3: Student Exchange State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-emerald-400">[03] Student Handwritten Note Archive</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Stores high-resolution handwritten notes, diagrams, and formula cheat sheets with community upvoting.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Community Votes: Real-Time</span>
                                    <span class="text-emerald-400">STATUS: DEPOSITED</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Narrative Story Cards Scrolling Alongside -->
                    <div class="lg:col-span-7 space-y-8">
                        <div class="split-story-card card-lift bg-white p-6 rounded-xl border border-oxford-200/90 shadow-subtle space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-xs font-bold bg-youtube-light text-youtube border border-red-200">Stage 01</span>
                                <h3 class="font-serif text-lg font-bold text-oxford-950">Visual Concept Mastery</h3>
                            </div>
                            <p class="text-xs sm:text-sm text-oxford-700 leading-relaxed">
                                Before tackling dense formulas, students often need intuitive geometry and animations. ISourceKO queries verified educational creators to bring the top explanation straight into your search feed.
                            </p>
                        </div>

                        <div class="split-story-card card-lift bg-white p-6 rounded-xl border border-oxford-200/90 shadow-subtle space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-xs font-bold bg-sciencedirect-light text-sciencedirect-dark border border-amber-200">Stage 02</span>
                                <h3 class="font-serif text-lg font-bold text-oxford-950">Academic Rigor & Journal Evidence</h3>
                            </div>
                            <p class="text-xs sm:text-sm text-oxford-700 leading-relaxed">
                                Back your term papers and lab reports with empirical citations. Directly access ScienceDirect and Semantic Scholar papers, complete with DOI links and one-click citation copying.
                            </p>
                        </div>

                        <div class="split-story-card card-lift bg-white p-6 rounded-xl border border-oxford-200/90 shadow-subtle space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-xs font-bold bg-evergreen-light text-evergreen-dark border border-emerald-200">Stage 03</span>
                                <h3 class="font-serif text-lg font-bold text-oxford-950">Peer Insights & Exam Cheat Sheets</h3>
                            </div>
                            <p class="text-xs sm:text-sm text-oxford-700 leading-relaxed">
                                Textbooks don't always explain the midterm trick. The Student Exchange section lets peers upload their own handwritten study notes, mindmaps, and solved edge-case examples.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private SearchQuery searchQuery = new();
    private SearchResponse? response;
    private List<string> trendingTopics = new();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        trendingTopics = await AggregatorService.GetTrendingTopicsAsync();
    }

    private async Task PerformSearch(SearchQuery query)
    {
        if (string.IsNullOrWhiteSpace(query.QueryText))
        {
            response = null;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            response = await AggregatorService.AggregateSearchAsync(query);
        }
        finally
        {
            isLoading = false;
        }
    }
}
