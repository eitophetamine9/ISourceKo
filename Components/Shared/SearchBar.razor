@using ISourceKO.Models
@using ISourceKO.Models.Enums

<div class="w-full bg-white rounded-lg shadow-subtle hover:shadow-lift border border-oxford-200/90 p-5 md:p-6 transition-all duration-200 reveal-on-scroll">
    <!-- Main Search Field with Pop Accents -->
    <form @onsubmit="TriggerSearch" class="flex flex-col md:flex-row items-stretch md:items-center gap-3">
        <div class="relative flex-1 group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-oxford-400 group-focus-within:text-flame transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input @bind="Query.QueryText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Search academic topics, journal papers, lecture videos, or student study notes..."
                   class="w-full pl-10 pr-9 py-3 bg-bone border border-oxford-200 rounded text-oxford-900 placeholder-oxford-400 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-oxford-950 focus:border-oxford-950 transition-all" />
            @if (!string.IsNullOrEmpty(Query.QueryText))
            {
                <button type="button" @onclick="ClearInput" aria-label="Clear search input" class="absolute inset-y-0 right-0 pr-3 flex items-center text-oxford-400 hover:text-flame transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>

        <!-- Academic Discipline Selector -->
        <div class="relative min-w-[180px]">
            <select @bind="Query.Field" class="w-full py-3 px-3 bg-bone border border-oxford-200 rounded text-oxford-800 text-sm focus:outline-none focus:ring-2 focus:ring-oxford-950 cursor-pointer transition-all">
                <option value="@AcademicField.General">All Disciplines</option>
                <option value="@AcademicField.ComputerScience">Computer Science</option>
                <option value="@AcademicField.NaturalSciences">Natural Sciences</option>
                <option value="@AcademicField.Mathematics">Mathematics</option>
                <option value="@AcademicField.Engineering">Engineering</option>
                <option value="@AcademicField.MedicineAndHealth">Medicine & Health</option>
                <option value="@AcademicField.SocialSciences">Social Sciences</option>
                <option value="@AcademicField.BusinessAndEconomics">Business & Economics</option>
            </select>
        </div>

        <!-- Search Action Button with Magnetic Effect -->
        <button type="submit" class="magnetic-btn btn-flame inline-flex items-center justify-center gap-2 px-6 py-3 rounded text-sm tracking-tight will-change-transform">
            <span>Query Index</span>
            <svg class="w-4 h-4 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
        </button>
    </form>

    <!-- Segmented Corpus Filter Bar with Dynamic Badges -->
    <div class="mt-4 pt-4 border-t border-oxford-100 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-oxford-500 mr-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-flame"></span>
            Corpus:
        </span>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.All)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.All ? "bg-oxford-950 text-bone shadow-subtle ring-1 ring-oxford-900" : "bg-oxford-100/80 text-oxford-700 hover:bg-oxford-200")">
            All Sources
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.YouTube)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.YouTube ? "bg-youtube text-white shadow-subtle ring-2 ring-red-300" : "bg-youtube-light text-youtube hover:bg-red-100 border border-red-200")">
            YouTube Lectures
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.OpenAlex)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.OpenAlex ? "bg-openalex text-white shadow-subtle ring-2 ring-teal-300" : "bg-openalex-light text-openalex-dark hover:bg-teal-100 border border-teal-200")">
            OpenAlex (Live)
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.ScienceDirect)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.ScienceDirect ? "bg-sciencedirect text-white shadow-subtle ring-2 ring-amber-300" : "bg-sciencedirect-light text-sciencedirect-dark hover:bg-amber-100 border border-amber-200")">
            ScienceDirect Papers
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.SemanticScholar)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.SemanticScholar ? "bg-scholar text-white shadow-subtle ring-2 ring-sky-300" : "bg-scholar-light text-scholar-dark hover:bg-sky-100 border border-sky-200")">
            Semantic Scholar
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.StudentCommunity)"
                class="interactive-tab px-3 py-1 rounded text-xs font-semibold transition-all @(Query.Platform == SourcePlatform.StudentCommunity ? "bg-evergreen text-white shadow-subtle ring-2 ring-emerald-300" : "bg-evergreen-light text-evergreen-dark hover:bg-emerald-100 border border-emerald-200")">
            Peer Notes & Links
        </button>
    </div>

    <!-- Suggested Topics Chips -->
    @if (TrendingTopics != null && TrendingTopics.Any())
    {
        <div class="mt-3.5 flex flex-wrap items-center gap-1.5 text-xs text-oxford-500">
            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-flame uppercase tracking-wider">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.474.966-.567 1.396-.104.478-.104.85-.104 1.05a5.535 5.535 0 00-2.316.896c-.44.304-.813.687-1.11 1.135C5.433 8.41 5 9.61 5 11a7 7 0 1014 0c0-1.636-.59-3.153-1.605-4.32-.44-.508-.98-.925-1.583-1.226a6.002 6.002 0 00-1.417-2.899zM10 16a5 5 0 01-5-5c0-1.07.34-2.02.906-2.753.308-.4.72-.733 1.19-.974.34-.174.72-.273 1.104-.273.7 0 1.344.27 1.83.74.52.502.83 1.2.83 1.96 0 .55.45 1 1 1s1-.45 1-1a4.978 4.978 0 00-.73-2.582c.484.27.915.63 1.258 1.066C14.717 8.995 15 9.948 15 11a5 5 0 01-5 5z" clip-rule="evenodd"/>
                </svg>
                Trending:
            </span>
            @foreach (var topic in TrendingTopics)
            {
                <button type="button"
                        @onclick="() => SelectTrending(topic)"
                        class="btn-press px-2.5 py-0.5 bg-oxford-50 hover:bg-flame-light hover:text-flame hover:border-flame/40 text-oxford-700 rounded border border-oxford-200/70 transition-all font-medium">
                    @topic
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SearchQuery Query { get; set; } = new();
    [Parameter] public List<string>? TrendingTopics { get; set; }
    [Parameter] public EventCallback<SearchQuery> OnSearch { get; set; }

    private async Task TriggerSearch()
    {
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectPlatform(SourcePlatform platform)
    {
        Query.Platform = platform;
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectTrending(string topic)
    {
        Query.QueryText = topic;
        await OnSearch.InvokeAsync(Query);
    }

    private void ClearInput()
    {
        Query.QueryText = string.Empty;
    }
}
