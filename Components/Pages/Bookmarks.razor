@page "/bookmarks"
@rendermode InteractiveServer
@inject IBookmarkService BookmarkService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Study Syllabus & Saved Sources — ISourceKO</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 pb-6 border-b border-oxford-200">
        <div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200 mb-2">
                <svg class="w-3.5 h-3.5 fill-amber-500 text-amber-500" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
                Personal Study Syllabus
            </span>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950 tracking-tight">
                Saved Academic Sources
            </h1>
            <p class="text-xs sm:text-sm text-oxford-600 mt-1">
                Your curated reading list of journal articles, video lectures, and student notes pinned for exam revision.
            </p>
        </div>

        @if (bookmarks.Any())
        {
            <div class="flex items-center gap-3">
                <button type="button"
                        @onclick="CopyAllCitations"
                        class="btn-press inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white border border-oxford-300 text-oxford-900 text-xs font-bold rounded shadow-subtle hover:bg-oxford-50 transition-all">
                    @if (isAllCopied)
                    {
                        <svg class="w-3.5 h-3.5 text-evergreen animate-scale-in" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-evergreen font-bold">Bibliography Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-oxford-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Export All Citations</span>
                    }
                </button>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-flame text-white font-mono shadow-subtle">@bookmarks.Count</span>
            </div>
        }
    </header>

    <div class="mt-8">
        @if (bookmarks.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
                @foreach (var item in bookmarks)
                {
                    <SourceCard Item="item" />
                }
            </div>
        }
        else
        {
            <div class="py-16 text-center max-w-md mx-auto">
                <div class="w-12 h-12 mx-auto mb-3 rounded bg-oxford-100 flex items-center justify-center text-oxford-500 border border-oxford-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </div>
                <h3 class="font-serif text-base font-semibold text-oxford-900">Your reading list is empty</h3>
                <p class="mt-1 text-xs text-oxford-600 leading-relaxed">
                    Pin papers, lectures, or peer notes while searching the hub to assemble your research bibliography.
                </p>
                <div class="mt-5">
                    <a href="" class="btn-flame inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs">
                        Query the Search Hub
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<SourceItem> bookmarks = new();
    private bool isAllCopied = false;

    protected override void OnInitialized()
    {
        BookmarkService.OnBookmarksChanged += HandleBookmarksChanged;
        LoadBookmarks();
    }

    private void LoadBookmarks()
    {
        bookmarks = BookmarkService.GetBookmarks().ToList();
    }

    private void HandleBookmarksChanged()
    {
        LoadBookmarks();
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyAllCitations()
    {
        var bibliography = string.Join("\n\n", bookmarks.Select(b =>
        {
            var year = b.PublishedDate?.Year.ToString() ?? "n.d.";
            return $"{b.AuthorOrPublisher} ({year}). {b.Title}. {b.Url}";
        }));

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", bibliography);
            isAllCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isAllCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    public void Dispose()
    {
        BookmarkService.OnBookmarksChanged -= HandleBookmarksChanged;
    }
}
