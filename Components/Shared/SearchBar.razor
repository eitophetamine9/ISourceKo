@using ISourceKO.Models
@using ISourceKO.Models.Enums

<div class="w-full bg-white rounded-lg shadow-subtle border border-oxford-200/90 p-5 md:p-6 transition-all duration-200">
    <!-- Main Search Field and Submit -->
    <form @onsubmit="TriggerSearch" class="flex flex-col md:flex-row items-stretch md:items-center gap-3">
        <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-oxford-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input @bind="Query.QueryText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Search academic topics, journal papers, lecture videos, or student study notes..."
                   class="w-full pl-10 pr-9 py-3 bg-bone border border-oxford-200 rounded text-oxford-900 placeholder-oxford-400 text-sm focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900 focus:border-oxford-900 transition-colors" />
            @if (!string.IsNullOrEmpty(Query.QueryText))
            {
                <button type="button" @onclick="ClearInput" aria-label="Clear search input" class="absolute inset-y-0 right-0 pr-3 flex items-center text-oxford-400 hover:text-oxford-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>

        <!-- Academic Discipline Selector -->
        <div class="relative min-w-[180px]">
            <select @bind="Query.Field" class="w-full py-3 px-3 bg-bone border border-oxford-200 rounded text-oxford-800 text-sm focus:outline-none focus:ring-1 focus:ring-oxford-900 focus:border-oxford-900 cursor-pointer">
                <option value="@AcademicField.General">All Disciplines</option>
                <option value="@AcademicField.ComputerScience">Computer Science</option>
                <option value="@AcademicField.NaturalSciences">Natural Sciences</option>
                <option value="@AcademicField.Mathematics">Mathematics</option>
                <option value="@AcademicField.Engineering">Engineering</option>
                <option value="@AcademicField.MedicineAndHealth">Medicine & Health</option>
                <option value="@AcademicField.SocialSciences">Social Sciences</option>
                <option value="@AcademicField.BusinessAndEconomics">Business & Economics</option>
            </select>
        </div>

        <!-- Search Action Button with Tactile Press -->
        <button type="submit" class="btn-press inline-flex items-center justify-center gap-2 px-6 py-3 bg-oxford-950 hover:bg-oxford-800 text-bone text-sm font-semibold rounded shadow-subtle border border-oxford-800">
            <span>Query Index</span>
            <svg class="w-4 h-4 text-oxford-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
        </button>
    </form>

    <!-- Segmented Corpus Filter Bar -->
    <div class="mt-4 pt-4 border-t border-oxford-100 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-oxford-500 mr-1">Corpus:</span>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.All)"
                class="interactive-tab px-3 py-1 rounded text-xs font-medium transition-all @(Query.Platform == SourcePlatform.All ? "bg-oxford-950 text-bone shadow-subtle" : "bg-oxford-100/80 text-oxford-700 hover:bg-oxford-200")">
            All Sources
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.YouTube)"
                class="interactive-tab px-3 py-1 rounded text-xs font-medium transition-all @(Query.Platform == SourcePlatform.YouTube ? "bg-youtube text-white shadow-subtle" : "bg-youtube-light text-youtube hover:bg-red-100 border border-red-200")">
            YouTube Lectures
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.ScienceDirect)"
                class="interactive-tab px-3 py-1 rounded text-xs font-medium transition-all @(Query.Platform == SourcePlatform.ScienceDirect ? "bg-sciencedirect text-white shadow-subtle" : "bg-sciencedirect-light text-sciencedirect-dark hover:bg-amber-100 border border-amber-200")">
            ScienceDirect Papers
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.SemanticScholar)"
                class="interactive-tab px-3 py-1 rounded text-xs font-medium transition-all @(Query.Platform == SourcePlatform.SemanticScholar ? "bg-scholar text-white shadow-subtle" : "bg-scholar-light text-scholar-dark hover:bg-sky-100 border border-sky-200")">
            Semantic Scholar
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.StudentCommunity)"
                class="interactive-tab px-3 py-1 rounded text-xs font-medium transition-all @(Query.Platform == SourcePlatform.StudentCommunity ? "bg-evergreen text-white shadow-subtle" : "bg-evergreen-light text-evergreen-dark hover:bg-emerald-100 border border-emerald-200")">
            Peer Notes & Links
        </button>
    </div>

    <!-- Suggested Topics Chips -->
    @if (TrendingTopics != null && TrendingTopics.Any())
    {
        <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-oxford-500">
            <span class="text-oxford-400">Common topics:</span>
            @foreach (var topic in TrendingTopics)
            {
                <button type="button"
                        @onclick="() => SelectTrending(topic)"
                        class="btn-press px-2.5 py-0.5 bg-oxford-50 hover:bg-oxford-100 text-oxford-700 rounded border border-oxford-200/60 transition-colors">
                    @topic
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SearchQuery Query { get; set; } = new();
    [Parameter] public List<string>? TrendingTopics { get; set; }
    [Parameter] public EventCallback<SearchQuery> OnSearch { get; set; }

    private async Task TriggerSearch()
    {
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectPlatform(SourcePlatform platform)
    {
        Query.Platform = platform;
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectTrending(string topic)
    {
        Query.QueryText = topic;
        await OnSearch.InvokeAsync(Query);
    }

    private void ClearInput()
    {
        Query.QueryText = string.Empty;
    }
}
