@using ISourceKO.Models
@inject IBookmarkService BookmarkService
@inject IJSRuntime JS

@if (Item != null && !string.IsNullOrEmpty(PdfUrl))
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-5 bg-oxford-950/85 backdrop-blur-md animate-fade-in"
         @onclick="Close">
        <div class="relative w-full max-w-6xl h-[92vh] bg-oxford-950 text-bone rounded-xl overflow-hidden shadow-pop border border-oxford-800 flex flex-col animate-scale-in"
             @onclick:stopPropagation="true">

            <!-- Viewer Header -->
            <div class="px-5 py-3.5 bg-oxford-950 border-b border-oxford-800 flex items-center justify-between gap-4 shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-bold bg-evergreen text-white shrink-0">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        Academic PDF
                    </span>
                    <h3 class="font-serif text-sm sm:text-base font-bold text-bone truncate" title="@Item.Title">
                        @Item.Title
                    </h3>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <a href="@PdfUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Open in new window"
                       class="btn-press hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-oxford-900 hover:bg-oxford-800 text-oxford-200 hover:text-bone text-xs font-semibold border border-oxford-700 transition-colors">
                        <span>New Tab</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>

                    <button type="button"
                            @onclick="Close"
                            aria-label="Close PDF reader"
                            class="btn-press p-1.5 rounded text-oxford-400 hover:text-bone hover:bg-oxford-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Viewer Body: Embedded PDF Canvas -->
            <div class="flex-1 bg-oxford-900 overflow-hidden relative">
                <object data="@PdfUrl" type="application/pdf" class="w-full h-full border-0 bg-white">
                    <iframe src="@PdfUrl" class="w-full h-full border-0 bg-white" title="@Item.Title">
                        <div class="p-8 text-center bg-oxford-950 text-bone h-full flex flex-col items-center justify-center">
                            <p class="text-sm text-oxford-300 mb-4">
                                This publisher's domain requires opening the PDF document in a direct browser tab.
                            </p>
                            <a href="@PdfUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-press inline-flex items-center gap-2 px-4 py-2 rounded bg-evergreen text-white font-bold text-xs shadow-lift">
                                <span>Open PDF in Browser Tab</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                            </a>
                        </div>
                    </iframe>
                </object>
            </div>

            <!-- Viewer Footer Bar -->
            <div class="px-5 py-3 bg-white text-oxford-900 border-t border-oxford-200 flex flex-wrap items-center justify-between gap-3 text-xs shrink-0">
                <div class="min-w-0">
                    <span class="font-bold text-oxford-950">@Item.AuthorOrPublisher</span>
                    @if (!string.IsNullOrEmpty(Item.MetricsInfo))
                    {
                        <span class="text-oxford-300 ml-1.5">•</span>
                        <span class="text-oxford-500 font-medium ml-1.5">@Item.MetricsInfo</span>
                    }
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <button type="button"
                            @onclick="ToggleBookmark"
                            class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 rounded border text-xs font-semibold transition-colors @(isBookmarked ? "bg-amber-50 border-amber-300 text-amber-900" : "bg-oxford-50 border-oxford-200 text-oxford-700 hover:bg-oxford-100")">
                        <svg class="w-3.5 h-3.5 @(isBookmarked ? "fill-amber-500 text-amber-500" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                        <span>@(isBookmarked ? "Saved" : "Save")</span>
                    </button>

                    @if (OnOpenCitation.HasDelegate)
                    {
                        <button type="button"
                                @onclick="OpenCitation"
                                class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-oxford-50 hover:bg-oxford-100 border border-oxford-200 text-oxford-800 text-xs font-semibold transition-colors">
                            <span>Cite Paper</span>
                        </button>
                    }

                    <a href="@PdfUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       download
                       class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-oxford-950 hover:bg-oxford-800 text-bone font-semibold text-xs transition-colors">
                        <span>Download PDF</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public SourceItem? Item { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SourceItem> OnOpenCitation { get; set; }

    private string? PdfUrl =>
        Item != null && Item.Metadata.TryGetValue("PdfUrl", out var url) && !string.IsNullOrWhiteSpace(url)
            ? url
            : (Item?.Url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true ? Item.Url : null);

    private bool isBookmarked => Item != null && BookmarkService.IsBookmarked(Item.Id);

    private void ToggleBookmark()
    {
        if (Item != null)
        {
            BookmarkService.ToggleBookmark(Item);
        }
    }

    private async Task OpenCitation()
    {
        if (Item != null)
        {
            var current = Item;
            await OnClose.InvokeAsync();
            await OnOpenCitation.InvokeAsync(current);
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
