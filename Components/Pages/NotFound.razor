@page "/not-found"
@layout MainLayout

<div class="max-w-md mx-auto text-center py-20 px-4">
    <div class="w-12 h-12 mx-auto mb-3 rounded bg-oxford-100 flex items-center justify-center text-oxford-500 border border-oxford-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    </div>
    <h1 class="font-serif text-2xl font-bold text-oxford-950">Record Not Found</h1>
    <p class="mt-2 text-xs text-oxford-600">The study source or catalog page you requested could not be located in the archive.</p>
    <div class="mt-5">
        <a href="" class="btn-press inline-flex items-center gap-1.5 px-4 py-2 bg-oxford-950 hover:bg-oxford-800 text-bone text-xs font-semibold rounded shadow-subtle border border-oxford-800">
            Return to Search Hub
        </a>
    </div>
</div>
