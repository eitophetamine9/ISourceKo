@using ISourceKO.Models
@using ISourceKO.Models.Enums
@inject IStudentSubmissionService SubmissionService

<div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between overflow-hidden">
    <!-- Image Preview if Student uploaded a note picture -->
    @if (!string.IsNullOrEmpty(Submission.ImagePath))
    {
        <div class="relative w-full h-48 bg-slate-100 overflow-hidden group cursor-pointer"
             @onclick="() => OnViewImage.InvokeAsync(Submission.ImagePath)">
            <img src="@Submission.ImagePath"
                 alt="@Submission.Title"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                 loading="lazy" />
            <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-3 py-1.5 bg-black/70 backdrop-blur-sm text-white text-xs font-medium rounded-full flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                    </svg>
                    Click to view full note
                </span>
            </div>
            <div class="absolute top-3 left-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-600/90 backdrop-blur-sm text-white shadow-sm">
                    📷 Handwritten / Diagram
                </span>
            </div>
        </div>
    }

    <div class="p-5 flex-1 flex flex-col justify-between">
        <div>
            <!-- Header Badges -->
            <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">
                    Peer Source
                </span>
                <span class="text-xs text-slate-400">
                    @Submission.SubmittedAt.ToString("MMM dd, yyyy")
                </span>
            </div>

            <!-- Title -->
            <h4 class="text-base font-bold text-slate-900 leading-snug">
                @if (!string.IsNullOrEmpty(Submission.SourceUrl))
                {
                    <a href="@Submission.SourceUrl" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 transition-colors flex items-start gap-1">
                        <span>@Submission.Title</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                }
                else
                {
                    <span>@Submission.Title</span>
                }
            </h4>

            <!-- Description -->
            <p class="mt-2 text-xs md:text-sm text-slate-600 leading-relaxed line-clamp-3">
                @Submission.Description
            </p>

            <!-- Tags -->
            @if (Submission.Tags.Any())
            {
                <div class="mt-3 flex flex-wrap gap-1">
                    @foreach (var tag in Submission.Tags)
                    {
                        <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-medium">
                            #@tag
                        </span>
                    }
                </div>
            }
        </div>

        <!-- Footer: Student Info + Upvote Button -->
        <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center">
                    @(Submission.StudentName.FirstOrDefault())
                </div>
                <div class="text-xs">
                    <p class="font-semibold text-slate-800 leading-none">@Submission.StudentName</p>
                    <p class="text-slate-400 text-[11px] mt-0.5">@(Submission.SchoolOrProgram ?? "Student")</p>
                </div>
            </div>

            <!-- Upvote Button -->
            <button type="button"
                    @onclick="Upvote"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 transition-colors text-xs font-semibold">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                </svg>
                <span>@Submission.Upvotes</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StudentSubmission Submission { get; set; } = default!;
    [Parameter] public EventCallback<string> OnViewImage { get; set; }

    private async Task Upvote()
    {
        var newCount = await SubmissionService.UpvoteAsync(Submission.Id);
        Submission.Upvotes = newCount;
    }
}
