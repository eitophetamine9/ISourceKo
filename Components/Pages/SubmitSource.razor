@page "/submit"
@rendermode InteractiveServer
@inject IStudentSubmissionService SubmissionService
@inject IFileStorageService StorageService
@inject NavigationManager Navigation

<PageTitle>Deposit Study Source or Handwritten Notes — ISourceKO</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <!-- Header -->
    <div class="mb-8">
        <a href="community" class="btn-press inline-flex items-center gap-1.5 text-xs font-semibold text-oxford-500 hover:text-oxford-900 transition-colors mb-3">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Peer Archive
        </a>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950 tracking-tight">
            Deposit a Study Resource into the Archive
        </h1>
        <p class="text-xs sm:text-sm text-oxford-600 mt-1 leading-relaxed">
            Contribute high-yield handwritten study summaries, exam formulas, or direct links to academic tools for your fellow students.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-6 p-4 rounded bg-red-50 border border-red-200 text-red-800 text-xs flex items-center gap-2.5">
            <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@errorMessage</span>
        </div>
    }

    <div class="bg-white rounded border border-oxford-200/90 shadow-subtle p-6 sm:p-8">
        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Submission Format Toggle (Segmented control) -->
            <div class="mb-6">
                <label class="block text-xs font-bold text-oxford-800 mb-2">
                    Deposit Format
                </label>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button"
                            @onclick="() => SetType(SubmissionType.ImageNote)"
                            class="interactive-tab p-3.5 rounded border text-left transition-all @(model.Type == SubmissionType.ImageNote ? "border-oxford-950 bg-oxford-50 text-oxford-950 shadow-subtle" : "border-oxford-200 hover:border-oxford-300 text-oxford-700 bg-white")">
                        <div class="flex items-center gap-2 font-bold text-xs">
                            <span class="text-sm">📷</span>
                            <span>Handwritten Notes / Diagram</span>
                        </div>
                        <p class="text-[11px] text-oxford-500 mt-1">Photo of study summary, formula sheet, or concept map</p>
                    </button>

                    <button type="button"
                            @onclick="() => SetType(SubmissionType.Link)"
                            class="interactive-tab p-3.5 rounded border text-left transition-all @(model.Type == SubmissionType.Link ? "border-oxford-950 bg-oxford-50 text-oxford-950 shadow-subtle" : "border-oxford-200 hover:border-oxford-300 text-oxford-700 bg-white")">
                        <div class="flex items-center gap-2 font-bold text-xs">
                            <span class="text-sm">🔗</span>
                            <span>Online Resource Link</span>
                        </div>
                        <p class="text-[11px] text-oxford-500 mt-1">Interactive visualizer, simulation, or paper link</p>
                    </button>
                </div>
            </div>

            <!-- Title -->
            <div class="mb-5">
                <label class="block text-xs font-semibold text-oxford-800 mb-1">Title *</label>
                <InputText @bind-Value="model.Title" placeholder="e.g. Graph Algorithms & Dijkstra Complexity Summary Sheet" class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
                <ValidationMessage For="@(() => model.Title)" class="text-red-600 text-[11px] mt-1" />
            </div>

            <!-- Conditional Link vs Image Upload -->
            @if (model.Type == SubmissionType.Link)
            {
                <div class="mb-5">
                    <label class="block text-xs font-semibold text-oxford-800 mb-1">Source URL *</label>
                    <InputText @bind-Value="model.SourceUrl" placeholder="https://..." class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
                </div>
            }
            else
            {
                <div class="mb-5">
                    <label class="block text-xs font-semibold text-oxford-800 mb-1">Upload Note Photo / Diagram *</label>
                    <div class="border border-dashed border-oxford-300 hover:border-oxford-900 rounded p-5 text-center bg-bone transition-colors">
                        <InputFile OnChange="HandleFileSelected" accept="image/*" class="block w-full text-xs text-oxford-600 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border file:border-oxford-300 file:text-xs file:font-semibold file:bg-white file:text-oxford-800 hover:file:bg-oxford-50 cursor-pointer" />
                        <p class="text-[11px] text-oxford-400 mt-2">Accepted formats: JPG, PNG, WebP (Max 10MB)</p>
                        @if (!string.IsNullOrEmpty(uploadedPreviewUrl))
                        {
                            <div class="mt-3 inline-block relative rounded overflow-hidden border border-oxford-200 max-h-36">
                                <img src="@uploadedPreviewUrl" alt="Preview" class="h-32 object-contain" />
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Discipline & Details -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-xs font-semibold text-oxford-800 mb-1">Academic Discipline</label>
                    <InputSelect @bind-Value="model.Field" class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-800 focus:outline-none focus:ring-1 focus:ring-oxford-900 cursor-pointer">
                        <option value="@AcademicField.ComputerScience">Computer Science</option>
                        <option value="@AcademicField.NaturalSciences">Natural Sciences</option>
                        <option value="@AcademicField.Mathematics">Mathematics</option>
                        <option value="@AcademicField.Engineering">Engineering</option>
                        <option value="@AcademicField.MedicineAndHealth">Medicine & Health</option>
                        <option value="@AcademicField.SocialSciences">Social Sciences</option>
                        <option value="@AcademicField.BusinessAndEconomics">Business & Economics</option>
                    </InputSelect>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-oxford-800 mb-1">Student Name / Alias *</label>
                    <InputText @bind-Value="model.StudentName" placeholder="e.g. Alex Chen" class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
                    <ValidationMessage For="@(() => model.StudentName)" class="text-red-600 text-[11px] mt-1" />
                </div>
            </div>

            <div class="mb-5">
                <label class="block text-xs font-semibold text-oxford-800 mb-1">Course / Year Level (Optional)</label>
                <InputText @bind-Value="model.SchoolOrProgram" placeholder="e.g. BS Computer Science • Year 2" class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
            </div>

            <!-- Description -->
            <div class="mb-5">
                <label class="block text-xs font-semibold text-oxford-800 mb-1">Description & Study Guidance *</label>
                <InputTextArea @bind-Value="model.Description" rows="4" placeholder="Explain the key concepts covered, formulas highlighted, and how other students should use this to prepare for exams..." class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
                <ValidationMessage For="@(() => model.Description)" class="text-red-600 text-[11px] mt-1" />
            </div>

            <!-- Tags -->
            <div class="mb-6">
                <label class="block text-xs font-semibold text-oxford-800 mb-1">Tags (Comma-separated)</label>
                <input type="text" @bind="tagsRaw" placeholder="Algorithms, Midterms, Graph Theory" class="w-full px-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-oxford-900" />
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-oxford-100">
                <a href="community" class="btn-press px-4 py-2 text-xs font-medium text-oxford-600 hover:text-oxford-900">Cancel</a>
                <button type="submit" disabled="@isSubmitting" class="btn-press px-5 py-2 bg-oxford-950 hover:bg-oxford-800 disabled:opacity-50 text-bone font-semibold text-xs rounded shadow-subtle border border-oxford-800">
                    @(isSubmitting ? "Depositing..." : "Deposit into Archive")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private StudentSubmission model = new() { Type = SubmissionType.ImageNote };
    private string tagsRaw = string.Empty;
    private string? errorMessage;
    private bool isSubmitting = false;
    private IBrowserFile? selectedFile;
    private string? uploadedPreviewUrl;

    private void SetType(SubmissionType type)
    {
        model.Type = type;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadedPreviewUrl = null;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (model.Type == SubmissionType.Link && string.IsNullOrWhiteSpace(model.SourceUrl))
        {
            errorMessage = "Please enter a valid URL for your shared resource.";
            return;
        }

        if (model.Type == SubmissionType.ImageNote && selectedFile == null && string.IsNullOrEmpty(model.ImagePath))
        {
            errorMessage = "Please choose an image file (handwritten note or diagram) to upload.";
            return;
        }

        isSubmitting = true;

        try
        {
            if (selectedFile != null)
            {
                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var path = await StorageService.SaveImageAsync(stream, selectedFile.Name);
                model.ImagePath = path;
            }

            if (!string.IsNullOrWhiteSpace(tagsRaw))
            {
                model.Tags = tagsRaw
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Distinct()
                    .ToList();
            }

            await SubmissionService.AddSubmissionAsync(model);
            Navigation.NavigateTo("community");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to deposit submission: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
