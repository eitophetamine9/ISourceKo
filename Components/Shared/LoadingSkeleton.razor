<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 animate-pulse">
    @for (int i = 0; i < Count; i++)
    {
        <div class="bg-white rounded border border-oxford-200/80 p-5 space-y-4">
            <div class="flex justify-between items-center">
                <div class="h-4 w-20 bg-oxford-100 rounded"></div>
                <div class="h-3 w-10 bg-oxford-100 rounded"></div>
            </div>
            <div class="h-5 bg-oxford-100 rounded w-4/5"></div>
            <div class="space-y-2">
                <div class="h-3 bg-oxford-50 rounded"></div>
                <div class="h-3 bg-oxford-50 rounded w-5/6"></div>
            </div>
            <div class="pt-3 border-t border-oxford-100 flex justify-between items-center">
                <div class="h-3 w-24 bg-oxford-100 rounded"></div>
                <div class="h-3 w-14 bg-oxford-100 rounded"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 6;
}
