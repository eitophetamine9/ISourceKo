<div class="py-16 px-4 text-center max-w-md mx-auto">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    </div>
    <h3 class="text-base font-semibold text-slate-800">@Title</h3>
    <p class="mt-1 text-sm text-slate-500 leading-relaxed">@Message</p>
</div>

@code {
    [Parameter] public string Title { get; set; } = "No sources found";
    [Parameter] public string Message { get; set; } = "Try searching for broader keywords, or select 'All Sources' to include YouTube, ScienceDirect, and student submissions.";
}
