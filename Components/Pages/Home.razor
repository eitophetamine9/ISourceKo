@page "/"
@rendermode InteractiveServer
@inject ISourceAggregatorService AggregatorService

<PageTitle>ISourceKO - Student Academic Hub</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200/60 text-indigo-700 text-xs font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
            Multi-Platform Academic Search Aggregator
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            One Search, <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-800">Every Source</span> You Need
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
            Find lecture videos from YouTube, peer-reviewed papers from ScienceDirect & Semantic Scholar, and handwritten notes shared by fellow students.
        </p>
    </div>

    <!-- Search Input Component -->
    <div class="max-w-4xl mx-auto mb-10">
        <SearchBar Query="searchQuery" TrendingTopics="trendingTopics" OnSearch="PerformSearch" />
    </div>

    <!-- Results Section -->
    <div class="max-w-7xl mx-auto">
        @if (isLoading)
        {
            <div class="py-6">
                <div class="flex items-center justify-between mb-4">
                    <div class="h-4 w-40 bg-slate-200 rounded animate-pulse"></div>
                    <div class="h-4 w-24 bg-slate-200 rounded animate-pulse"></div>
                </div>
                <LoadingSkeleton Count="6" />
            </div>
        }
        else if (response != null && !string.IsNullOrWhiteSpace(response.Query))
        {
            <!-- Results Header & Platform Breakdowns -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-6 border-b border-slate-200">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">
                        Results for "<span class="text-indigo-600">@response.Query</span>"
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Found @response.TotalResults sources in @(Math.Round(response.ElapsedTime.TotalMilliseconds))ms
                    </p>
                </div>

                <!-- Counts per Platform Pills -->
                <div class="flex flex-wrap items-center gap-2">
                    @foreach (var kvp in response.CountByPlatform)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-xs font-medium text-slate-600 shadow-sm">
                            <PlatformBadge Platform="kvp.Key" />
                            <span class="font-bold text-slate-800">@kvp.Value</span>
                        </span>
                    }
                </div>
            </div>

            @if (response.Items.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var item in response.Items)
                    {
                        <SourceCard Item="item" />
                    }
                </div>
            }
            else
            {
                <EmptyState Title="No sources found" Message="Try searching with a broader keyword, or check your platform filters." />
            }
        }
        else
        {
            <!-- Default Welcome State: Platform Feature Cards -->
            <div class="pt-6 pb-12">
                <div class="text-center mb-8">
                    <h3 class="text-lg font-bold text-slate-900">Platforms Aggregated Inside ISourceKO</h3>
                    <p class="text-xs text-slate-500 mt-1">Cross-reference visual video explainers with verified academic journal literature and student peer contributions.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center mb-3">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm">YouTube Learning</h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">Curated video lectures, visual intuitions, and university symposiums from verified educators.</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center mb-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm">ScienceDirect</h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">Peer-reviewed Elsevier scientific journal articles, research methodologies, and meta-analyses.</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center mb-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm">Semantic Scholar</h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">AI-backed academic research papers with citation graphs, DOI indexes, and key findings.</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm">Student Community</h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">Real study notes, handwritten diagrams, formula cheat sheets, and links contributed by peers.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private SearchQuery searchQuery = new();
    private SearchResponse? response;
    private List<string> trendingTopics = new();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        trendingTopics = await AggregatorService.GetTrendingTopicsAsync();
    }

    private async Task PerformSearch(SearchQuery query)
    {
        if (string.IsNullOrWhiteSpace(query.QueryText))
        {
            response = null;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            response = await AggregatorService.AggregateSearchAsync(query);
        }
        finally
        {
            isLoading = false;
        }
    }
}
