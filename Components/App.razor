<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ISourceKO — Unified collegiate research engine aggregating live OpenAlex papers, Semantic Scholar citations, ScienceDirect articles, in-app YouTube lectures, and student handwritten notes." />
    <meta name="theme-color" content="#0C131F" />
    <meta property="og:title" content="ISourceKO — Academic Source Hub & Student Exchange" />
    <meta property="og:description" content="Search live scholarly papers, watch lectures in a distraction-free theater, export APA/MLA/Chicago/BibTeX citations, and exchange handwritten student study notes." />
    <meta property="og:type" content="website" />
    <base href="/" />
    <title>ISourceKO — Academic Source Hub & Student Exchange</title>
    
    <!-- Editorial Two-Font Pairing: Newsreader (Display Serif) + Plus Jakarta Sans (Interface/Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="css/tailwind.min.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="bg-[#FBFBF9] text-[#0C131F] font-sans antialiased min-h-screen selection:bg-flame/15 selection:text-oxford-950 overflow-x-hidden">
    <!-- Dynamic Reading Scroll Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-flame via-amber-500 to-academic z-50 transition-all duration-75 pointer-events-none" style="width: 0%"></div>

    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    
    <!-- Core Blazor Framework -->
    <script src="@Assets["_framework/blazor.web.js"]"></script>

    <!-- 60fps Motion Engine: Lenis Smooth Scroll + GSAP + ScrollTrigger -->
    <script src="js/lenis.min.js"></script>
    <script src="js/gsap.min.js"></script>
    <script src="js/ScrollTrigger.min.js"></script>
    <script src="js/animations.js"></script>
    <script src="js/storage.js"></script>

    <!-- Blazor Navigation & Mutation Re-initialization Hook -->
    <script>
        (function() {
            let ticking = false;
            window.addEventListener('scroll', function() {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
                        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
                        const progressBar = document.getElementById('reading-progress');
                        if (progressBar) {
                            progressBar.style.width = scrolled + '%';
                        }
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });

            // Re-trigger animations on Blazor enhanced navigation
            document.addEventListener('blazor:navigated', function() {
                if (window.initISourceKOAnimations) {
                    setTimeout(window.initISourceKOAnimations, 100);
                }
            });
        })();
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
