@using ISourceKO.Models
@using ISourceKO.Models.Enums
@inject IBookmarkService BookmarkService
@inject IJSRuntime JS

@if (Item.Platform == SourcePlatform.YouTube)
{
    <!-- VIDEO LECTURE DOSSIER -->
    <article class="card-lift bg-white rounded border border-oxford-200/90 shadow-subtle p-4 flex flex-col justify-between group">
        <div>
            <!-- Video Thumbnail Frame with Hover Zoom & Duration Pill -->
            @if (!string.IsNullOrEmpty(Item.ThumbnailUrl))
            {
                <div class="relative w-full aspect-video rounded overflow-hidden mb-3 bg-oxford-100 img-zoom-frame border border-oxford-200/60">
                    <img src="@Item.ThumbnailUrl" alt="@Item.Title" class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute inset-0 bg-oxford-950/20 group-hover:bg-transparent transition-colors"></div>
                    @if (Item.Metadata.TryGetValue("Duration", out var duration))
                    {
                        <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-oxford-950/80 text-bone text-[11px] font-mono font-medium tracking-tight">
                            @duration
                        </span>
                    }
                    <div class="absolute top-2 left-2">
                        <PlatformBadge Platform="Item.Platform" />
                    </div>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between mb-2">
                    <PlatformBadge Platform="Item.Platform" />
                </div>
            }

            <!-- Video Title in Editorial Serif -->
            <h3 class="font-serif text-base font-semibold text-oxford-950 leading-snug">
                <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="hover:underline decoration-oxford-400 underline-offset-2 flex items-start gap-1">
                    <span>@Item.Title</span>
                </a>
            </h3>

            <!-- Description -->
            <p class="mt-2 text-xs text-oxford-600 line-clamp-2 leading-relaxed">
                @Item.Description
            </p>
        </div>

        <!-- Video Footer with Channel, Metrics & Actions -->
        <div class="mt-4 pt-3 border-t border-oxford-100 flex items-center justify-between text-xs text-oxford-500">
            <div class="flex items-center gap-2 truncate">
                <span class="font-medium text-oxford-800 truncate">@Item.AuthorOrPublisher</span>
                @if (!string.IsNullOrEmpty(Item.MetricsInfo))
                {
                    <span class="text-oxford-300">•</span>
                    <span class="text-oxford-500 text-[11px] shrink-0">@Item.MetricsInfo</span>
                }
            </div>

            <div class="flex items-center gap-1 shrink-0">
                <button type="button"
                        @onclick="ToggleBookmark"
                        title="@(isBookmarked ? "Remove Bookmark" : "Save Bookmark")"
                        class="btn-press p-1.5 text-oxford-400 hover:text-amber-600 rounded transition-colors">
                    <svg class="w-4 h-4 @(isBookmarked ? "fill-amber-500 text-amber-500" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </button>
                <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="btn-press px-2.5 py-1 bg-oxford-50 hover:bg-oxford-100 text-oxford-800 font-medium text-xs rounded border border-oxford-200">
                    Watch
                </a>
            </div>
        </div>
    </article>
}
else
{
    <!-- ACADEMIC RESEARCH DOSSIER (ScienceDirect, Semantic Scholar, etc.) -->
    <article class="card-lift bg-white rounded border border-oxford-200/90 shadow-subtle p-5 flex flex-col justify-between">
        <div>
            <!-- Header: Platform Badge, Field, & Bookmark Button -->
            <div class="flex items-center justify-between gap-3 mb-2.5">
                <div class="flex items-center gap-2">
                    <PlatformBadge Platform="Item.Platform" />
                    @if (Item.Metadata.TryGetValue("DOI", out var doi))
                    {
                        <span class="text-[11px] font-mono text-oxford-500">DOI:@doi</span>
                    }
                </div>

                <div class="flex items-center gap-1.5">
                    @if (Item.Field != AcademicField.General)
                    {
                        <span class="text-[11px] px-2 py-0.5 bg-oxford-50 text-oxford-600 rounded border border-oxford-200/50 font-medium">
                            @Item.Field.ToString()
                        </span>
                    }
                    
                    <button type="button"
                            @onclick="ToggleBookmark"
                            title="@(isBookmarked ? "Remove Bookmark" : "Save Bookmark")"
                            class="btn-press p-1.5 text-oxford-400 hover:text-amber-600 rounded transition-colors">
                        <svg class="w-4 h-4 @(isBookmarked ? "fill-amber-500 text-amber-500" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Paper Title in Scholarly Serif -->
            <h3 class="font-serif text-lg font-semibold text-oxford-950 leading-snug">
                <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="hover:underline decoration-oxford-400 underline-offset-2">
                    @Item.Title
                </a>
            </h3>

            <!-- Journal Attribution & Publication Year -->
            <div class="mt-1 text-xs text-oxford-500 font-medium">
                <span>@Item.AuthorOrPublisher</span>
                @if (Item.PublishedDate.HasValue)
                {
                    <span> • @Item.PublishedDate.Value.ToString("yyyy")</span>
                }
            </div>

            <!-- Abstract Snippet -->
            <p class="mt-2.5 text-xs md:text-sm text-oxford-700 leading-relaxed line-clamp-3">
                @Item.Description
            </p>

            <!-- Tags -->
            @if (Item.Tags.Any())
            {
                <div class="mt-3 flex flex-wrap gap-1.5">
                    @foreach (var tag in Item.Tags.Take(3))
                    {
                        <span class="text-[11px] bg-bone text-oxford-600 border border-oxford-200/60 px-2 py-0.5 rounded">
                            #@tag
                        </span>
                    }
                </div>
            }
        </div>

        <!-- Academic Actions Footer -->
        <div class="mt-5 pt-3.5 border-t border-oxford-100 flex items-center justify-between text-xs">
            <span class="text-oxford-500 text-[11px] font-medium">
                @(Item.MetricsInfo ?? "Scholarly Record")
            </span>

            <div class="flex items-center gap-2">
                <!-- Copy Citation Button with Dynamic Checkmark Feedback -->
                <button type="button"
                        @onclick="CopyCitation"
                        class="btn-press inline-flex items-center gap-1 px-2 py-1 bg-oxford-50 hover:bg-oxford-100 text-oxford-700 rounded border border-oxford-200 text-xs font-medium">
                    @if (isCopied)
                    {
                        <svg class="w-3.5 h-3.5 text-evergreen" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-evergreen font-semibold">Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-oxford-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Cite</span>
                    }
                </button>

                <a href="@Item.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn-press inline-flex items-center gap-1 px-3 py-1 bg-oxford-950 text-bone hover:bg-oxford-800 rounded font-medium text-xs shadow-subtle">
                    <span>Read Paper</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public SourceItem Item { get; set; } = default!;

    private bool isBookmarked => BookmarkService.IsBookmarked(Item.Id);
    private bool isCopied = false;

    private void ToggleBookmark()
    {
        BookmarkService.ToggleBookmark(Item);
    }

    private async Task CopyCitation()
    {
        var year = Item.PublishedDate?.Year.ToString() ?? "n.d.";
        var citation = $"{Item.AuthorOrPublisher} ({year}). {Item.Title}. Retrieved from {Item.Url}";

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", citation);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Fallback
        }
    }
}
