@page "/community"
@rendermode InteractiveServer
@inject IStudentSubmissionService SubmissionService

<PageTitle>Student Notes & Source Exchange — ISourceKO</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- Masthead Section -->
    <header class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 pb-6 border-b border-oxford-200">
        <div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-bold bg-evergreen-light text-evergreen-dark border border-emerald-300 mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-evergreen animate-pulse"></span>
                Student Exchange Archive
            </span>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950 tracking-tight">
                Peer-Contributed Study Sources & Notes
            </h1>
            <p class="text-xs sm:text-sm text-oxford-600 mt-1 max-w-xl leading-relaxed">
                Handwritten summaries, reaction diagrams, formula sheets, and study links deposited by university students.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="submit" class="btn-flame inline-flex items-center gap-2 px-4 py-2 rounded text-xs tracking-tight shadow-subtle">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>Deposit Note or Link</span>
            </a>
        </div>
    </header>

    <!-- Study Hall Two-Column Asymmetric Layout -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
        <!-- Left Filter Rail -->
        <aside class="lg:col-span-1 bg-white p-5 rounded-lg border border-oxford-200/90 shadow-subtle space-y-6 lg:sticky lg:top-24">
            <div>
                <label class="block text-xs font-bold text-oxford-900 uppercase tracking-wider mb-2 flex items-center justify-between">
                    <span>Search Archive</span>
                    @if (!string.IsNullOrEmpty(filterQuery))
                    {
                        <span class="w-2 h-2 rounded-full bg-flame"></span>
                    }
                </label>
                <div class="relative">
                    <input @bind="filterQuery"
                           @bind:event="oninput"
                           @bind:after="ApplyFilters"
                           type="text"
                           placeholder="Search note tags, courses..."
                           class="w-full pl-8 pr-3 py-2 bg-bone border border-oxford-200 rounded text-xs text-oxford-900 focus:outline-none focus:ring-1 focus:ring-oxford-900 transition-colors" />
                    <svg class="w-3.5 h-3.5 text-oxford-400 absolute left-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>

            <!-- Format Filter -->
            <div>
                <label class="block text-xs font-bold text-oxford-900 uppercase tracking-wider mb-2">
                    Submission Format
                </label>
                <div class="flex flex-col gap-1 text-xs">
                    <button type="button"
                            @onclick="() => FilterByType(null)"
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors @(selectedType == null ? "bg-oxford-950 text-bone shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        All Formats
                    </button>
                    <button type="button"
                            @onclick="() => FilterByType(SubmissionType.ImageNote)"
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors flex items-center gap-1.5 @(selectedType == SubmissionType.ImageNote ? "bg-oxford-950 text-bone shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span>Photos & Handwritten</span>
                    </button>
                    <button type="button"
                            @onclick="() => FilterByType(SubmissionType.Link)"
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors flex items-center gap-1.5 @(selectedType == SubmissionType.Link ? "bg-oxford-950 text-bone shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                        <span>Web Resources & Tools</span>
                    </button>
                    <button type="button"
                            @onclick="() => FilterByType(SubmissionType.TextNote)"
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors flex items-center gap-1.5 @(selectedType == SubmissionType.TextNote ? "bg-oxford-950 text-bone shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>Written Study Notes</span>
                    </button>
                </div>
            </div>

            <!-- Origin Provenance Filter -->
            <div>
                <label class="block text-xs font-bold text-oxford-900 uppercase tracking-wider mb-2">
                    Note Origin
                </label>
                <div class="flex flex-col gap-1 text-xs">
                    <button type="button"
                            @onclick='() => FilterByOrigin("all")'
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors @(originFilter == "all" ? "bg-oxford-950 text-bone shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        All Sources
                    </button>
                    <button type="button"
                            @onclick='() => FilterByOrigin("user")'
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors flex items-center gap-1.5 @(originFilter == "user" ? "bg-evergreen-dark text-white shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        <span>Made by Peers Only</span>
                    </button>
                    <button type="button"
                            @onclick='() => FilterByOrigin("system")'
                            class="interactive-tab w-full text-left px-2.5 py-1.5 rounded font-semibold transition-colors flex items-center gap-1.5 @(originFilter == "system" ? "bg-indigo-700 text-white shadow-subtle" : "text-oxford-700 hover:bg-oxford-100")">
                        <span>System Premade Only</span>
                    </button>
                </div>
            </div>

            <!-- Subject Filter -->
            <div>
                <label class="block text-xs font-bold text-oxford-900 uppercase tracking-wider mb-2">
                    Subject
                </label>
                <select @bind="selectedField" @bind:after="ApplyFilters" class="w-full py-2 px-2.5 bg-bone border border-oxford-200 rounded text-xs text-oxford-800 focus:outline-none focus:ring-1 focus:ring-oxford-900 cursor-pointer">
                    <option value="@AcademicField.General">All Subjects</option>
                    @foreach (var subject in AcademicFieldExtensions.AllSubjects)
                    {
                        <option value="@subject">@subject.GetDisplayName()</option>
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div>
                <label class="block text-xs font-bold text-oxford-900 uppercase tracking-wider mb-2">
                    Sort Order
                </label>
                <select @bind="sortBy" @bind:after="ApplyFilters" class="w-full py-2 px-2.5 bg-bone border border-oxford-200 rounded text-xs text-oxford-800 focus:outline-none focus:ring-1 focus:ring-oxford-900 cursor-pointer">
                    <option value="newest">Recently Deposited</option>
                    <option value="top">Most Upvoted by Students</option>
                    <option value="comments">Most Discussed</option>
                </select>
            </div>
        </aside>

        <!-- Right Main Submissions Stream -->
        <main class="lg:col-span-3 space-y-6">
            @if (isLoading)
            {
                <LoadingSkeleton Count="4" />
            }
            else if (VisibleSubmissions.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-fade-in">
                    @foreach (var submission in VisibleSubmissions)
                    {
                        <StudentSourceCard Submission="submission"
                                           OnViewImage="OpenImageModal"
                                           OnDelete="HandleSubmissionDeleted"
                                           OnReadNote="OpenNoteModal" />
                    }
                </div>
            }
            else
            {
                <EmptyState Title="No student submissions matched" Message="Try adjusting your subject or origin filter, or be the first student to upload a note for this topic!" />
            }
        </main>
    </div>
</div>

<!-- Darkroom Modal for Full Note Photo -->
<ImageModal ImageUrl="@activeModalImage" OnClose="CloseImageModal" />

<!-- In-App Study Note Reader Modal -->
<StudyNoteModal Note="@activeModalNote" OnClose="CloseNoteModal" />

@code {
    [SupplyParameterFromQuery(Name = "note")]
    public string? NoteIdQuery { get; set; }

    private List<StudentSubmission> submissions = new();
    private string filterQuery = string.Empty;
    private SubmissionType? selectedType = null;
    private AcademicField selectedField = AcademicField.General;
    private string sortBy = "newest";
    private string originFilter = "all";
    private bool isLoading = true;
    private string? activeModalImage;
    private StudentSubmission? activeModalNote;
    private string? handledNoteQuery;

    private IEnumerable<StudentSubmission> VisibleSubmissions => originFilter switch
    {
        "user" => submissions.Where(s => !s.IsSystemGenerated),
        "system" => submissions.Where(s => s.IsSystemGenerated),
        _ => submissions
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSubmissions();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(NoteIdQuery) &&
            !string.Equals(handledNoteQuery, NoteIdQuery, StringComparison.OrdinalIgnoreCase))
        {
            handledNoteQuery = NoteIdQuery;
            var match = submissions.FirstOrDefault(s => string.Equals(s.Id, NoteIdQuery, StringComparison.OrdinalIgnoreCase));
            if (match == null)
            {
                match = await SubmissionService.GetByIdAsync(NoteIdQuery);
            }
            if (match != null)
            {
                activeModalNote = match;
            }
        }
    }

    private async Task LoadSubmissions()
    {
        isLoading = true;
        try
        {
            submissions = await SubmissionService.GetSubmissionsAsync(
                query: filterQuery,
                field: selectedField == AcademicField.General ? null : selectedField,
                type: selectedType,
                sortBy: sortBy);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        await LoadSubmissions();
    }

    private async Task FilterByType(SubmissionType? type)
    {
        selectedType = type;
        await LoadSubmissions();
    }

    private void FilterByOrigin(string origin)
    {
        originFilter = origin;
    }

    private void OpenImageModal(string imageUrl)
    {
        activeModalImage = imageUrl;
    }

    private void CloseImageModal()
    {
        activeModalImage = null;
    }

    private void OpenNoteModal(StudentSubmission submission)
    {
        activeModalNote = submission;
    }

    private void CloseNoteModal()
    {
        activeModalNote = null;
    }

    private void HandleSubmissionDeleted(string id)
    {
        submissions.RemoveAll(s => s.Id == id);
        StateHasChanged();
    }
}
