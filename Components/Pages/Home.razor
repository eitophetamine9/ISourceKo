    private async Task OpenStudyNoteModal(SourceItem item)
    {
        var loaded = await SubmissionService.GetByIdAsync(item.Id);
        if (loaded != null)
        {
            activeStudyNote = loaded;
            return;
        }

        var isSystem = item.Metadata.TryGetValue("IsSystemGenerated", out var sysVal) &&
                       string.Equals(sysVal, "true", StringComparison.OrdinalIgnoreCase);

        var fallback = new StudentSubmission
        {
            Id = item.Id,
            Title = item.Title,
            Description = item.Description,
            Field = item.Field,
            StudentName = isSystem ? "ISource Gen" : item.AuthorOrPublisher,
            SubmittedAt = item.PublishedDate ?? DateTime.UtcNow,
            Tags = item.Tags,
            IsSystemGenerated = isSystem
        };
        StudyNoteGeneratorService.EnsureHydrated(fallback);
        activeStudyNote = fallback;
    }

