@using ISourceKO.Models
@using ISourceKO.Models.Enums

<div class="w-full bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-5 md:p-6 transition-all duration-200">
    <!-- Main Search Bar -->
    <form @onsubmit="TriggerSearch" class="flex flex-col md:flex-row items-stretch md:items-center gap-3">
        <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input @bind="Query.QueryText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Search topics, research papers, lecture videos, or student study notes..."
                   class="w-full pl-11 pr-10 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 text-sm md:text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-150" />
            @if (!string.IsNullOrEmpty(Query.QueryText))
            {
                <button type="button" @onclick="ClearInput" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>

        <!-- Academic Field Selector -->
        <div class="relative min-w-[180px]">
            <select @bind="Query.Field" class="w-full py-3.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer">
                <option value="@AcademicField.General">All Disciplines</option>
                <option value="@AcademicField.ComputerScience">Computer Science</option>
                <option value="@AcademicField.NaturalSciences">Natural Sciences</option>
                <option value="@AcademicField.Mathematics">Mathematics</option>
                <option value="@AcademicField.Engineering">Engineering</option>
                <option value="@AcademicField.MedicineAndHealth">Medicine & Health</option>
                <option value="@AcademicField.SocialSciences">Social Sciences</option>
                <option value="@AcademicField.BusinessAndEconomics">Business & Economics</option>
            </select>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-sm md:text-base rounded-xl shadow-sm hover:shadow-indigo-200 hover:shadow-md transition-all duration-150">
            <span>Find Sources</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
        </button>
    </form>

    <!-- Platform Filter Pills -->
    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-1">Filter Source:</span>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.All)"
                class="px-3 py-1 rounded-lg text-xs font-medium transition-all duration-150 @(Query.Platform == SourcePlatform.All ? "bg-slate-900 text-white shadow-sm" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
            All Sources
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.YouTube)"
                class="px-3 py-1 rounded-lg text-xs font-medium transition-all duration-150 @(Query.Platform == SourcePlatform.YouTube ? "bg-red-600 text-white shadow-sm" : "bg-red-50 text-red-700 hover:bg-red-100 border border-red-200/60")">
            YouTube Lectures
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.ScienceDirect)"
                class="px-3 py-1 rounded-lg text-xs font-medium transition-all duration-150 @(Query.Platform == SourcePlatform.ScienceDirect ? "bg-orange-600 text-white shadow-sm" : "bg-orange-50 text-orange-800 hover:bg-orange-100 border border-orange-200/60")">
            ScienceDirect Papers
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.SemanticScholar)"
                class="px-3 py-1 rounded-lg text-xs font-medium transition-all duration-150 @(Query.Platform == SourcePlatform.SemanticScholar ? "bg-blue-600 text-white shadow-sm" : "bg-blue-50 text-blue-800 hover:bg-blue-100 border border-blue-200/60")">
            Semantic Scholar
        </button>

        <button type="button"
                @onclick="() => SelectPlatform(SourcePlatform.StudentCommunity)"
                class="px-3 py-1 rounded-lg text-xs font-medium transition-all duration-150 @(Query.Platform == SourcePlatform.StudentCommunity ? "bg-emerald-600 text-white shadow-sm" : "bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200/60")">
            Student Submissions
        </button>
    </div>

    <!-- Quick Trending Search Tags -->
    @if (TrendingTopics != null && TrendingTopics.Any())
    {
        <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
            <span class="font-medium text-slate-400">Try searching:</span>
            @foreach (var topic in TrendingTopics)
            {
                <button type="button"
                        @onclick="() => SelectTrending(topic)"
                        class="px-2.5 py-0.5 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 rounded-md transition-colors">
                    @topic
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SearchQuery Query { get; set; } = new();
    [Parameter] public List<string>? TrendingTopics { get; set; }
    [Parameter] public EventCallback<SearchQuery> OnSearch { get; set; }

    private async Task TriggerSearch()
    {
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectPlatform(SourcePlatform platform)
    {
        Query.Platform = platform;
        await OnSearch.InvokeAsync(Query);
    }

    private async Task SelectTrending(string topic)
    {
        Query.QueryText = topic;
        await OnSearch.InvokeAsync(Query);
    }

    private void ClearInput()
    {
        Query.QueryText = string.Empty;
    }
}
