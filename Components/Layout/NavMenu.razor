@inject IBookmarkService BookmarkService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-40 bg-[#FBFBF9]/95 backdrop-blur-md border-b border-oxford-200/80 transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Masthead Brand Mark with Flame Accent -->
            <div class="flex items-center gap-3">
                <a href="" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-oxford-900 rounded p-1">
                    <div class="relative w-9 h-9 rounded bg-oxford-950 text-bone flex items-center justify-center font-serif text-lg font-bold tracking-tighter border border-oxford-800 group-hover:border-flame transition-colors">
                        IS
                        <!-- Visual Flame Spark on Logo -->
                        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-flame border-2 border-[#FBFBF9]"></span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-serif text-xl font-bold tracking-tight text-oxford-950 leading-none group-hover:text-flame transition-colors">ISourceKO</span>
                        <span class="text-[10.5px] font-sans font-medium text-oxford-500 tracking-normal mt-0.5">Collegiate Research Hub</span>
                    </div>
                </a>
            </div>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center gap-1 font-sans text-sm">
                <NavLink href="" Match="NavLinkMatch.All" class="px-3.5 py-1.5 rounded text-oxford-700 hover:text-oxford-950 hover:bg-oxford-100/70 transition-all font-medium" ActiveClass="!text-oxford-950 !bg-white shadow-subtle !border !border-oxford-200 !font-semibold">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-oxford-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        Search Hub
                    </span>
                </NavLink>

                <NavLink href="community" class="px-3.5 py-1.5 rounded text-oxford-700 hover:text-oxford-950 hover:bg-oxford-100/70 transition-all font-medium" ActiveClass="!text-oxford-950 !bg-white shadow-subtle !border !border-oxford-200 !font-semibold">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-evergreen-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        Peer Notes & Links
                    </span>
                </NavLink>

                <NavLink href="bookmarks" class="px-3.5 py-1.5 rounded text-oxford-700 hover:text-oxford-950 hover:bg-oxford-100/70 transition-all font-medium" ActiveClass="!text-oxford-950 !bg-white shadow-subtle !border !border-oxford-200 !font-semibold">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-oxford-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                        Saved Sources
                        @if (bookmarkCount > 0)
                        {
                            <span class="ml-1 px-1.5 py-0.2 rounded-full text-[11px] font-bold bg-flame text-white animate-scale-in">@bookmarkCount</span>
                        }
                    </span>
                </NavLink>
            </nav>

            <!-- Right Action: Magnetic Pop Button -->
            <div class="hidden md:flex items-center gap-3">
                <a href="submit" class="magnetic-btn btn-flame inline-flex items-center gap-2 px-4 py-2 rounded text-xs tracking-tight shadow-subtle will-change-transform">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Contribute Source</span>
                </a>
            </div>

            <!-- Mobile menu trigger -->
            <div class="flex items-center md:hidden">
                <button type="button"
                        @onclick="ToggleMobileMenu"
                        aria-label="Toggle navigation"
                        aria-expanded="@isMobileMenuOpen"
                        aria-controls="mobile-nav-drawer"
                        class="btn-press p-2 rounded text-oxford-700 hover:text-oxford-950 hover:bg-oxford-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-oxford-900">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        @if (isMobileMenuOpen)
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        }
                        else
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        }
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Drawer -->
    @if (isMobileMenuOpen)
    {
        <div id="mobile-nav-drawer" class="md:hidden border-t border-oxford-200 bg-[#FBFBF9] px-4 pt-3 pb-5 space-y-2 animate-fade-in">
            <NavLink href="" Match="NavLinkMatch.All" class="block px-3 py-2 rounded text-base font-medium text-oxford-800 hover:bg-oxford-100" ActiveClass="!bg-white !text-oxford-950 !font-semibold border border-oxford-200" @onclick="CloseMobileMenu">
                Search Hub
            </NavLink>
            <NavLink href="community" class="block px-3 py-2 rounded text-base font-medium text-oxford-800 hover:bg-oxford-100" ActiveClass="!bg-white !text-oxford-950 !font-semibold border border-oxford-200" @onclick="CloseMobileMenu">
                Peer Notes &amp; Links
            </NavLink>
            <NavLink href="bookmarks" class="block px-3 py-2 rounded text-base font-medium text-oxford-800 hover:bg-oxford-100" ActiveClass="!bg-white !text-oxford-950 !font-semibold border border-oxford-200" @onclick="CloseMobileMenu">
                Saved Sources (@bookmarkCount)
            </NavLink>
            <div class="pt-2">
                <a href="submit" class="btn-flame w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded font-medium text-sm" @onclick="CloseMobileMenu">
                    + Contribute Source
                </a>
            </div>
        </div>
    }
</header>

@code {
    private bool isMobileMenuOpen = false;
    private int bookmarkCount => BookmarkService.GetBookmarks().Count;

    protected override void OnInitialized()
    {
        BookmarkService.OnBookmarksChanged += HandleBookmarksChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientId = await JS.InvokeAsync<string>("isourcekoStorage.getOrCreateClientId");
                await BookmarkService.InitializeClientAsync(clientId);
            }
            catch { }
        }
    }

    private void HandleBookmarksChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isMobileMenuOpen)
        {
            isMobileMenuOpen = false;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await Task.Delay(120);
            await JS.InvokeVoidAsync("initISourceKOAnimations");
        }
        catch { }
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    public void Dispose()
    {
        BookmarkService.OnBookmarksChanged -= HandleBookmarksChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
