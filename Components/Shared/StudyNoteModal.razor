@using ISourceKO.Models
@using ISourceKO.Models.Enums
@inject IJSRuntime JS

@if (Note != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-oxford-950/80 backdrop-blur-sm animate-fade-in"
         data-lenis-prevent
         @onclick="Close">
        <div class="relative w-full max-w-3xl max-h-[90vh] bg-bone text-oxford-950 rounded-xl overflow-hidden shadow-pop border border-oxford-300 flex flex-col animate-scale-in"
             data-lenis-prevent
             @onclick:stopPropagation="true">

            <!-- Reader Header -->
            <div class="px-6 py-4 bg-white border-b border-oxford-200 flex items-start justify-between gap-4">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                        @if (Note.IsSystemGenerated)
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-50 text-indigo-800 border border-indigo-200">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                                </svg>
                                System Premade
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-evergreen-light text-evergreen-dark border border-emerald-200">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Made by Peer
                            </span>
                        }

                        @if (Note.Field != AcademicField.General)
                        {
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-oxford-50 text-oxford-700 border border-oxford-200">
                                @Note.Field.GetDisplayName()
                            </span>
                        }

                        <span class="text-[11px] font-mono text-oxford-400">
                            @Note.SubmittedAt.ToString("MMM dd, yyyy")
                        </span>
                    </div>

                    <h3 class="font-serif text-lg sm:text-xl font-bold text-oxford-950 leading-snug">
                        @Note.Title
                    </h3>
                    <p class="text-xs text-oxford-500 mt-1">
                        @if (Note.IsSystemGenerated)
                        {
                            <span>Generated by <strong class="text-oxford-800">ISource Gen</strong>@(string.IsNullOrWhiteSpace(Note.SchoolOrProgram) ? "" : $" ({Note.SchoolOrProgram})")</span>
                        }
                        else
                        {
                            <span>Authored by <strong class="text-oxford-800">@Note.StudentName</strong>@(string.IsNullOrWhiteSpace(Note.SchoolOrProgram) ? "" : $" ({Note.SchoolOrProgram})")</span>
                        }
                    </p>
                </div>

                <button type="button"
                        @onclick="Close"
                        aria-label="Close study note"
                        class="btn-press p-1.5 rounded text-oxford-400 hover:text-oxford-900 hover:bg-oxford-100 transition-colors shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Study Note Body -->
            <div class="flex-1 overflow-y-auto overscroll-contain px-6 py-5 space-y-2.5 text-sm leading-relaxed"
                 data-lenis-prevent>
                @foreach (var line in GetFormattedLines())
                {
                    @if (line.StartsWith("## "))
                    {
                        <h4 class="font-serif text-base font-bold text-oxford-950 pt-3 pb-1 border-b border-oxford-200 mt-2">
                            @line.Substring(3)
                        </h4>
                    }
                    else if (line.StartsWith("# "))
                    {
                        <p class="font-serif text-base font-bold text-oxford-900">
                            @line.Substring(2)
                        </p>
                    }
                    else if (line.StartsWith("- "))
                    {
                        <div class="flex items-start gap-2 pl-1 text-xs sm:text-sm text-oxford-800">
                            <span class="w-1.5 h-1.5 rounded-full bg-flame mt-2 shrink-0"></span>
                            <span>@line.Substring(2)</span>
                        </div>
                    }
                    else if (line.StartsWith("| "))
                    {
                        <pre class="px-3 py-1.5 bg-white border border-oxford-200 rounded font-mono text-xs text-oxford-800 overflow-x-auto">@line</pre>
                    }
                    else if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="h-1"></div>
                    }
                    else
                    {
                        <p class="text-xs sm:text-sm text-oxford-800 leading-relaxed">@line</p>
                    }
                }
            </div>

            <!-- Footer Actions -->
            <div class="px-6 py-3.5 bg-white border-t border-oxford-200 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var tag in Note.Tags.Take(4))
                    {
                        <span class="text-[11px] bg-bone text-oxford-600 border border-oxford-200 px-2 py-0.5 rounded font-medium">
                            #@tag
                        </span>
                    }
                </div>

                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="CopyNote"
                            class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-oxford-300 text-oxford-800 hover:bg-oxford-50 rounded text-xs font-semibold">
                        <span>@(isCopied ? "Copied!" : "Copy Note")</span>
                    </button>
                    <button type="button"
                            @onclick="DownloadNote"
                            class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-oxford-950 hover:bg-oxford-800 text-bone rounded text-xs font-semibold">
                        <span>Download (.md)</span>
                    </button>
                    <button type="button"
                            @onclick="Close"
                            class="btn-press px-3 py-1.5 bg-oxford-100 hover:bg-oxford-200 text-oxford-800 rounded text-xs font-semibold">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public StudentSubmission? Note { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isCopied = false;

    private IEnumerable<string> GetFormattedLines()
    {
        var content = !string.IsNullOrWhiteSpace(Note?.NoteContent)
            ? Note.NoteContent
            : Note?.Description ?? string.Empty;

        return content.Replace("\r\n", "\n").Split('\n');
    }

    private async Task CopyNote()
    {
        if (Note == null) return;
        var text = Note.NoteContent ?? Note.Description;
        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.copyText", text);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task DownloadNote()
    {
        if (Note == null) return;
        var text = Note.NoteContent ?? Note.Description;
        var safeSlug = new string(Note.Title.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        if (safeSlug.Length > 40) safeSlug = safeSlug.Substring(0, 40);
        var filename = $"isourceko-note-{safeSlug}.md";
        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.downloadTextFile", filename, text);
        }
        catch { }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
