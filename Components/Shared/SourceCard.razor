@using ISourceKO.Models
@using ISourceKO.Models.Enums
@using ISourceKO.Services
@inject IBookmarkService BookmarkService
@inject IJSRuntime JS

@if (Item.Platform == SourcePlatform.YouTube)
{
    <!-- VIDEO LECTURE DOSSIER -->
    <article class="card-lift bg-white rounded-lg border border-oxford-200/90 shadow-subtle p-4 flex flex-col justify-between group relative overflow-hidden">
        <div>
            <!-- Video Thumbnail Frame with Hover Zoom, Play Trigger & Duration Pill -->
            @if (!string.IsNullOrEmpty(Item.ThumbnailUrl))
            {
                <div class="relative w-full aspect-video rounded overflow-hidden mb-3 bg-oxford-100 img-zoom-frame border border-oxford-200/60 shadow-inner @(HasVideoId && OnWatchVideo.HasDelegate ? "cursor-pointer" : "")"
                     @onclick="HandleThumbnailClick">
                    <img src="@Item.ThumbnailUrl" alt="@Item.Title" class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute inset-0 bg-oxford-950/25 group-hover:bg-oxford-950/15 transition-colors flex items-center justify-center">
                        @if (HasVideoId && OnWatchVideo.HasDelegate)
                        {
                            <span class="w-11 h-11 rounded-full bg-oxford-950/85 group-hover:bg-flame text-white flex items-center justify-center shadow-lift transition-all duration-200 group-hover:scale-110">
                                <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M8 5v14l11-7z" />
                                </svg>
                            </span>
                        }
                    </div>

                    @if (Item.Metadata.TryGetValue("Duration", out var duration) && !string.IsNullOrWhiteSpace(duration))
                    {
                        <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-oxford-950/85 backdrop-blur-sm text-bone text-[11px] font-mono font-semibold tracking-tight shadow-subtle">
                            @duration
                        </span>
                    }
                    <div class="absolute top-2 left-2">
                        <PlatformBadge Platform="Item.Platform" />
                    </div>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between mb-2">
                    <PlatformBadge Platform="Item.Platform" />
                </div>
            }

            <!-- Video Title in Editorial Serif -->
            <h3 class="font-serif text-base font-bold text-oxford-950 leading-snug group-hover:text-flame transition-colors">
                @if (HasVideoId && OnWatchVideo.HasDelegate)
                {
                    <button type="button" @onclick="WatchInTheater" class="text-left hover:underline decoration-flame underline-offset-2">
                        @Item.Title
                    </button>
                }
                else
                {
                    <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="hover:underline decoration-flame underline-offset-2 flex items-start gap-1">
                        <span>@Item.Title</span>
                    </a>
                }
            </h3>

            <!-- Description -->
            <p class="mt-2 text-xs text-oxford-600 line-clamp-2 leading-relaxed">
                @Item.Description
            </p>
        </div>

        <!-- Video Footer with Channel, Metrics & Actions -->
        <div class="mt-4 pt-3 border-t border-oxford-100 flex items-center justify-between gap-2 text-xs text-oxford-500">
            <div class="flex items-center gap-1.5 min-w-0 truncate">
                <span class="font-semibold text-oxford-800 truncate">@Item.AuthorOrPublisher</span>
                @if (!string.IsNullOrEmpty(Item.MetricsInfo))
                {
                    <span class="text-oxford-300">•</span>
                    <span class="text-oxford-500 text-[11px] shrink-0 font-medium truncate">@Item.MetricsInfo</span>
                }
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button"
                        @onclick="ToggleBookmark"
                        title="@(isBookmarked ? "Remove Bookmark" : "Save Bookmark")"
                        class="btn-press p-1.5 text-oxford-400 hover:text-amber-500 rounded transition-colors">
                    <svg class="w-4 h-4 @(isBookmarked ? "fill-amber-500 text-amber-500 animate-scale-in" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </button>

                <button type="button"
                        @onclick="TriggerCitation"
                        title="Cite this lecture"
                        class="btn-press px-2 py-1 bg-oxford-50 hover:bg-oxford-100 text-oxford-700 rounded border border-oxford-200 text-[11px] font-semibold transition-colors">
                    Cite
                </button>

                @if (HasVideoId && OnWatchVideo.HasDelegate)
                {
                    <button type="button"
                            @onclick="WatchInTheater"
                            class="btn-press px-3 py-1 bg-oxford-900 hover:bg-oxford-800 text-white font-medium text-xs rounded border border-oxford-800 shadow-subtle flex items-center gap-1">
                        <span>Watch</span>
                        <svg class="w-3 h-3 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    </button>
                }
                else
                {
                    <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="btn-press px-3 py-1 bg-oxford-900 hover:bg-oxford-800 text-white font-medium text-xs rounded border border-oxford-800 shadow-subtle flex items-center gap-1">
                        <span>Watch</span>
                        <svg class="w-3 h-3 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    </a>
                }
            </div>
        </div>
    </article>
}
else
{
    <!-- ACADEMIC RESEARCH DOSSIER (OpenAlex, ScienceDirect, Semantic Scholar, etc.) -->
    <article class="card-lift bg-white rounded-lg border border-oxford-200/90 shadow-subtle p-5 flex flex-col justify-between group relative overflow-hidden">
        <!-- Live API / High-Citation Indicator -->
        @if (IsLiveSource)
        {
            <div class="absolute top-0 right-0">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-bl bg-openalex-light border-l border-b border-teal-200 text-openalex-dark text-[10px] font-bold tracking-tight">
                    <span class="w-1.5 h-1.5 rounded-full bg-openalex"></span>
                    Live Index
                </span>
            </div>
        }
        else if (Item.MetricsInfo != null && (Item.MetricsInfo.Contains("citations") || Item.MetricsInfo.Contains("Patents")))
        {
            <div class="absolute top-0 right-0">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-bl bg-amber-500/10 border-l border-b border-amber-300 text-amber-900 text-[10px] font-bold tracking-tight">
                    ★ Academic Highlight
                </span>
            </div>
        }

        <div>
            <!-- Header: Platform Badge, DOI, & Bookmark Button -->
            <div class="flex items-center justify-between gap-3 mb-2.5 pt-1">
                <div class="flex items-center gap-2 min-w-0">
                    <PlatformBadge Platform="Item.Platform" />
                    @if (Item.Metadata.TryGetValue("DOI", out var doi) && !string.IsNullOrWhiteSpace(doi))
                    {
                        <span class="text-[11px] font-mono text-oxford-400 truncate max-w-[140px]" title="@doi">DOI:@doi</span>
                    }
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                    @if (Item.Field != AcademicField.General)
                    {
                        <span class="text-[11px] px-2 py-0.5 bg-oxford-50 text-oxford-600 rounded border border-oxford-200 font-medium">
                            @Item.Field.ToString()
                        </span>
                    }

                    <button type="button"
                            @onclick="ToggleBookmark"
                            title="@(isBookmarked ? "Remove Bookmark" : "Save Bookmark")"
                            class="btn-press p-1.5 text-oxford-400 hover:text-amber-500 rounded transition-colors">
                        <svg class="w-4 h-4 @(isBookmarked ? "fill-amber-500 text-amber-500 animate-scale-in" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Paper Title in Scholarly Serif -->
            <h3 class="font-serif text-lg font-bold text-oxford-950 leading-snug group-hover:text-academic transition-colors">
                <a href="@Item.Url" target="_blank" rel="noopener noreferrer" class="hover:underline decoration-academic underline-offset-2">
                    @Item.Title
                </a>
            </h3>

            <!-- Journal Attribution & Year -->
            <div class="mt-1 text-xs text-oxford-500 font-medium">
                <span>@Item.AuthorOrPublisher</span>
                @if (Item.PublishedDate.HasValue)
                {
                    <span class="text-oxford-400"> • @Item.PublishedDate.Value.ToString("yyyy")</span>
                }
            </div>

            <!-- Abstract Snippet -->
            <p class="mt-2.5 text-xs md:text-sm text-oxford-700 leading-relaxed line-clamp-3">
                @Item.Description
            </p>

            <!-- Tags -->
            @if (Item.Tags.Any())
            {
                <div class="mt-3 flex flex-wrap gap-1.5">
                    @foreach (var tag in Item.Tags.Take(3))
                    {
                        <span class="text-[11px] bg-bone text-oxford-600 border border-oxford-200 px-2 py-0.5 rounded font-medium">
                            #@tag
                        </span>
                    }
                </div>
            }
        </div>

        <!-- Academic Actions Footer -->
        <div class="mt-5 pt-3.5 border-t border-oxford-100 flex flex-wrap items-center justify-between gap-2 text-xs">
            <span class="text-oxford-500 text-[11px] font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full @(Item.Platform == SourcePlatform.OpenAlex ? "bg-openalex" : "bg-sciencedirect")"></span>
                @(Item.MetricsInfo ?? "Scholarly Record")
            </span>

            <div class="flex items-center gap-1.5">
                @if (Item.Metadata.TryGetValue("PdfUrl", out var pdfUrl) && !string.IsNullOrWhiteSpace(pdfUrl))
                {
                    <a href="@pdfUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Open Access PDF"
                       class="btn-press inline-flex items-center gap-1 px-2.5 py-1 bg-evergreen-light hover:bg-emerald-100 text-evergreen-dark rounded border border-emerald-200 text-xs font-bold transition-colors">
                        <span>PDF</span>
                    </a>
                }

                <!-- Citation Suite Trigger -->
                <button type="button"
                        @onclick="TriggerCitation"
                        class="btn-press inline-flex items-center gap-1.5 px-2.5 py-1 bg-oxford-50 hover:bg-oxford-100 text-oxford-800 rounded border border-oxford-200 text-xs font-semibold transition-all">
                    @if (isCopied)
                    {
                        <svg class="w-3.5 h-3.5 text-evergreen animate-scale-in" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-evergreen font-bold">Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-oxford-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Cite</span>
                    }
                </button>

                <a href="@Item.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn-press inline-flex items-center gap-1 px-3 py-1 bg-oxford-950 text-bone hover:bg-oxford-800 rounded font-medium text-xs shadow-subtle">
                    <span>Full Text</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public SourceItem Item { get; set; } = default!;
    [Parameter] public EventCallback<SourceItem> OnWatchVideo { get; set; }
    [Parameter] public EventCallback<SourceItem> OnOpenCitation { get; set; }

    private bool isBookmarked => BookmarkService.IsBookmarked(Item.Id);
    private bool isCopied = false;

    private bool HasVideoId =>
        Item.Metadata.TryGetValue("VideoId", out var vid) && !string.IsNullOrWhiteSpace(vid);

    private bool IsLiveSource =>
        Item.Metadata.TryGetValue("SourceMode", out var mode) &&
        mode.StartsWith("Live", StringComparison.OrdinalIgnoreCase);

    private void ToggleBookmark()
    {
        BookmarkService.ToggleBookmark(Item);
    }

    private async Task HandleThumbnailClick()
    {
        if (HasVideoId && OnWatchVideo.HasDelegate)
        {
            await WatchInTheater();
        }
    }

    private async Task WatchInTheater()
    {
        if (OnWatchVideo.HasDelegate)
        {
            await OnWatchVideo.InvokeAsync(Item);
        }
    }

    private async Task TriggerCitation()
    {
        if (OnOpenCitation.HasDelegate)
        {
            await OnOpenCitation.InvokeAsync(Item);
            return;
        }

        var citation = CitationFormatter.Format(Item, CitationStyle.Apa7);
        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.copyText", citation);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch { }
    }
}
