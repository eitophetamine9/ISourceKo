@page "/bookmarks"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using ISourceKO.Models
@using ISourceKO.Models.Enums
@using ISourceKO.Services
@inject IBookmarkService BookmarkService
@inject IStudentSubmissionService SubmissionService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Study Syllabus & Saved Sources — ISourceKO</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 pb-6 border-b border-oxford-200">
        <div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200 mb-2">
                <svg class="w-3.5 h-3.5 fill-amber-500 text-amber-500" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
                Personal Study Syllabus • Portable JSON &amp; SQLite
            </span>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950 tracking-tight">
                Saved Academic Sources
            </h1>
            <p class="text-xs sm:text-sm text-oxford-600 mt-1">
                Your curated reading list of journal articles, video lectures, and student notes. Export a portable JSON save file to back up or share with peers.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Always available: Import JSON Save File -->
            <label class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-oxford-300 text-oxford-900 text-xs font-bold rounded shadow-subtle hover:bg-oxford-50 transition-all cursor-pointer"
                   title="Upload a previously exported ISourceKO .json backup file">
                <svg class="w-3.5 h-3.5 text-oxford-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Import JSON</span>
                <InputFile OnChange="HandleJsonFileSelected" accept=".json,application/json" class="hidden" />
            </label>

            @if (bookmarks.Any())
            {
                <button type="button"
                        @onclick="() => isAssistantOpen = true"
                        title="Ask AI questions grounded strictly in your saved sources"
                        class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-oxford-900 hover:bg-oxford-800 text-bone text-xs font-bold rounded shadow-subtle transition-all">
                    <span>Ask Syllabus (AI)</span>
                </button>

                <button type="button"
                        @onclick="ExportJsonBackup"
                        title="Download a portable JSON backup of your saved bookmarks and lecture scratchpad notes"
                        class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-oxford-950 hover:bg-oxford-800 text-bone text-xs font-bold rounded shadow-subtle transition-all">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span>@(isJsonExported ? "JSON Exported!" : "Export JSON")</span>
                </button>

                <select @bind="exportStyle"
                        aria-label="Citation export style"
                        class="py-1.5 px-2.5 bg-bone border border-oxford-300 rounded text-xs font-semibold text-oxford-800 focus:outline-none focus:ring-1 focus:ring-oxford-950 cursor-pointer">
                    <option value="@CitationStyle.Apa7">APA 7th</option>
                    <option value="@CitationStyle.Mla9">MLA 9th</option>
                    <option value="@CitationStyle.Chicago17">Chicago 17th</option>
                    <option value="@CitationStyle.BibTeX">BibTeX (.bib)</option>
                </select>

                <button type="button"
                        @onclick="CopyAllCitations"
                        class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-oxford-300 text-oxford-900 text-xs font-bold rounded shadow-subtle hover:bg-oxford-50 transition-all">
                    @if (isAllCopied)
                    {
                        <svg class="w-3.5 h-3.5 text-evergreen animate-scale-in" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-evergreen font-bold">Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-oxford-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Copy All</span>
                    }
                </button>

                @if (exportStyle == CitationStyle.BibTeX)
                {
                    <button type="button"
                            @onclick="DownloadAllBibTeX"
                            class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-oxford-950 text-bone text-xs font-bold rounded shadow-subtle hover:bg-oxford-800 transition-all">
                        <span>Download .bib</span>
                    </button>
                }

                <button type="button"
                        @onclick="ExportMarkdownStudyGuide"
                        title="Export complete study guide with citations and lecture notes as Markdown"
                        class="btn-press inline-flex items-center gap-1.5 px-3 py-1.5 bg-flame hover:bg-flame-dark text-white text-xs font-bold rounded shadow-subtle transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>@(isGuideExported ? "Study Guide Exported!" : "Export Study Guide (.md)")</span>
                </button>

                @if (confirmClearAll)
                {
                    <div class="inline-flex items-center gap-1.5 bg-red-50 border border-red-200 px-2 py-1 rounded">
                        <button type="button"
                                @onclick="ConfirmClearAll"
                                class="px-2 py-0.5 bg-red-700 hover:bg-red-800 text-white text-[11px] font-bold rounded">
                            Confirm Clear
                        </button>
                        <button type="button"
                                @onclick="() => confirmClearAll = false"
                                class="px-2 py-0.5 text-oxford-700 hover:text-oxford-950 text-[11px] font-semibold">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <button type="button"
                            @onclick="() => confirmClearAll = true"
                            title="Clear all saved bookmarks for this browser"
                            class="btn-press inline-flex items-center gap-1 px-2.5 py-1.5 bg-white border border-oxford-200 text-oxford-500 hover:text-red-700 hover:border-red-300 hover:bg-red-50 text-xs font-semibold rounded transition-colors">
                        <span>Clear All</span>
                    </button>
                }

                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-oxford-950 text-white font-mono shadow-subtle">@bookmarks.Count</span>
            }
        </div>
    </header>

    <!-- JSON Import Status & Preview Banners -->
    @if (!string.IsNullOrEmpty(importErrorMessage))
    {
        <div class="mt-5 p-3.5 rounded-lg bg-red-50 border border-red-200 text-red-800 text-xs flex items-center justify-between gap-3 animate-scale-in">
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@importErrorMessage</span>
            </div>
            <button type="button" @onclick="() => importErrorMessage = null" class="text-red-500 hover:text-red-800 font-bold">Dismiss</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(importSuccessMessage))
    {
        <div class="mt-5 p-3.5 rounded-lg bg-evergreen-light border border-emerald-300 text-evergreen-dark text-xs flex items-center justify-between gap-3 animate-scale-in">
            <div class="flex items-center gap-2 font-medium">
                <svg class="w-4 h-4 text-evergreen shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>@importSuccessMessage</span>
            </div>
            <button type="button" @onclick="() => importSuccessMessage = null" class="text-evergreen-dark hover:underline font-bold">Dismiss</button>
        </div>
    }

    @if (pendingImportBundle != null)
    {
        <div class="mt-5 p-4 rounded-lg bg-white border border-oxford-300 shadow-subtle animate-scale-in">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-oxford-950 text-bone uppercase tracking-wider">Ready to Import</span>
                        <span class="text-xs font-mono text-oxford-500">@pendingImportFileName</span>
                    </div>
                    <p class="text-xs text-oxford-800">
                        Found <strong>@pendingImportBundle.Bookmarks.Count saved source(s)</strong> and
                        <strong>@pendingImportBundle.VideoNotes.Count lecture note(s)</strong>
                        (exported @pendingImportBundle.ExportedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")).
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    @if (bookmarks.Any())
                    {
                        <div class="flex items-center gap-2 text-xs bg-bone px-2.5 py-1.5 rounded border border-oxford-200">
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium text-oxford-800">
                                <input type="radio" name="importMode" checked="@(!replaceOnImport)" @onchange="() => replaceOnImport = false" />
                                <span>Merge</span>
                            </label>
                            <span class="text-oxford-300">|</span>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium text-oxford-800">
                                <input type="radio" name="importMode" checked="@replaceOnImport" @onchange="() => replaceOnImport = true" />
                                <span>Replace current</span>
                            </label>
                        </div>
                    }

                    <button type="button"
                            @onclick="CancelJsonImport"
                            class="btn-press px-3 py-1.5 text-xs font-semibold text-oxford-600 hover:text-oxford-900 border border-oxford-200 rounded bg-white">
                        Cancel
                    </button>
                    <button type="button"
                            @onclick="ConfirmJsonImport"
                            disabled="@isImporting"
                            class="btn-flame px-4 py-1.5 text-xs font-bold text-white rounded shadow-subtle disabled:opacity-50">
                        @(isImporting ? "Importing..." : "Confirm Import")
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="mt-8">
        @if (bookmarks.Any())
        {
            <!-- Course & Subject Folders Filter Navigation -->
            @if (subjectGroups.Count > 1)
            {
                <div class="mb-6 flex flex-wrap items-center gap-2 pb-3 border-b border-oxford-200 text-xs">
                    <span class="text-oxford-500 font-semibold uppercase tracking-wider text-[11px] mr-1 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-oxford-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>
                        Subject Folders:
                    </span>

                    <button type="button"
                            @onclick="() => SelectFolder(null)"
                            class="btn-press px-2.5 py-1 rounded text-xs font-semibold transition-all @(selectedField == null ? "bg-oxford-950 text-bone shadow-subtle" : "bg-white text-oxford-700 border border-oxford-200 hover:bg-oxford-50")">
                        All Saved (@bookmarks.Count)
                    </button>

                    @foreach (var group in subjectGroups)
                    {
                        <button type="button"
                                @onclick="() => SelectFolder(group.Field)"
                                class="btn-press px-2.5 py-1 rounded text-xs font-semibold transition-all @(selectedField == group.Field ? "bg-flame text-white shadow-subtle" : "bg-white text-oxford-700 border border-oxford-200 hover:bg-oxford-50")">
                            <span>@group.Field</span>
                            <span class="ml-1 font-mono text-[11px] opacity-80">(@group.Count)</span>
                        </button>
                    }
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
                @foreach (var item in FilteredBookmarks)
                {
                    <SourceCard Item="item"
                                OnWatchVideo="OpenVideoModal"
                                OnReadPdf="OpenPdfModal"
                                OnReadNote="OpenStudyNoteModal"
                                OnOpenCitation="OpenCitationModal" />
                }
            </div>
        }
        else
        {
            <div class="py-16 text-center max-w-md mx-auto">
                <div class="w-12 h-12 mx-auto mb-3 rounded bg-oxford-100 flex items-center justify-center text-oxford-500 border border-oxford-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </div>
                <h3 class="font-serif text-base font-semibold text-oxford-900">Your reading list is empty</h3>
                <p class="mt-1 text-xs text-oxford-600 leading-relaxed">
                    Pin papers, lectures, or peer notes while searching the hub to assemble your persistent research bibliography, or restore a shared JSON save file.
                </p>
                <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
                    <a href="" class="btn-flame inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs">
                        Query the Search Hub
                    </a>
                    <label class="btn-press inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs font-bold bg-white border border-oxford-300 text-oxford-800 hover:bg-oxford-50 cursor-pointer shadow-subtle">
                        <svg class="w-3.5 h-3.5 text-oxford-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                        </svg>
                        <span>Upload Save File (.json)</span>
                        <InputFile OnChange="HandleJsonFileSelected" accept=".json,application/json" class="hidden" />
                    </label>
                </div>
            </div>
        }
    </div>
</div>

<!-- In-App Lecture Theater Modal -->
<VideoPlayerModal Item="@activeVideoItem"
                  OnClose="CloseVideoModal"
                  OnOpenCitation="OpenCitationModal" />

<!-- In-App Distraction-Free PDF Reader Modal -->
<PdfViewerModal Item="@activePdfItem"
                OnClose="ClosePdfModal"
                OnOpenCitation="OpenCitationModal" />

<!-- Multi-Style Academic Citation Modal -->
<CitationModal Item="@activeCitationItem"
               OnClose="CloseCitationModal" />

<!-- In-App Study Note Reader Modal -->
<StudyNoteModal Note="@activeStudyNote"
                OnClose="CloseStudyNoteModal" />

<!-- Source-Grounded Research Assistant Modal -->
<ResearchAssistantModal IsOpen="isAssistantOpen"
                        Sources="bookmarks"
                        OnClose="() => isAssistantOpen = false" />

@code {
    private static readonly JsonSerializerOptions BackupJsonOptions = new()
    {
        WriteIndented = true,
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    private List<SourceItem> bookmarks = new();
    private CitationStyle exportStyle = CitationStyle.Apa7;
    private bool isAllCopied = false;
    private bool isGuideExported = false;
    private bool isJsonExported = false;
    private bool isImporting = false;
    private bool replaceOnImport = false;
    private bool confirmClearAll = false;
    private BookmarkBackupBundle? pendingImportBundle;
    private string? pendingImportFileName;
    private string? importSuccessMessage;
    private string? importErrorMessage;
    private AcademicField? selectedField = null;
    private SourceItem? activeVideoItem;
    private SourceItem? activePdfItem;
    private SourceItem? activeCitationItem;
    private StudentSubmission? activeStudyNote;
    private bool isAssistantOpen = false;

    private IEnumerable<SourceItem> FilteredBookmarks =>
        selectedField.HasValue
            ? bookmarks.Where(b => b.Field == selectedField.Value)
            : bookmarks;

    private List<(AcademicField Field, int Count)> subjectGroups =>
        bookmarks
            .GroupBy(b => b.Field)
            .Select(g => (Field: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .ToList();

    protected override void OnInitialized()
    {
        BookmarkService.OnBookmarksChanged += HandleBookmarksChanged;
        LoadBookmarks();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientId = await JS.InvokeAsync<string>("isourcekoStorage.getOrCreateClientId");
                await BookmarkService.InitializeClientAsync(clientId);
                LoadBookmarks();
                StateHasChanged();
            }
            catch { }
        }
    }

    private void LoadBookmarks()
    {
        bookmarks = BookmarkService.GetBookmarks().ToList();
    }

    private void HandleBookmarksChanged()
    {
        LoadBookmarks();
        InvokeAsync(StateHasChanged);
    }

    private void SelectFolder(AcademicField? field)
    {
        selectedField = field;
    }

    private async Task CopyAllCitations()
    {
        var targetList = FilteredBookmarks.ToList();
        var bibliography = CitationFormatter.FormatAll(targetList, exportStyle);

        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.copyText", bibliography);
            isAllCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isAllCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task DownloadAllBibTeX()
    {
        var targetList = FilteredBookmarks.ToList();
        var bib = CitationFormatter.FormatAll(targetList, CitationStyle.BibTeX);
        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.downloadTextFile", "isourceko-syllabus.bib", bib);
        }
        catch { }
    }

    private async Task ExportMarkdownStudyGuide()
    {
        if (!bookmarks.Any()) return;

        var sb = new StringBuilder();
        sb.AppendLine("# ISourceKO Academic Study Syllabus & Reading Guide");
        sb.AppendLine($"Generated: {DateTime.Now:MMMM dd, yyyy} | Total Curated Sources: {bookmarks.Count}");
        sb.AppendLine();
        sb.AppendLine("> *Exported from ISourceKO — Unified collegiate research engine synthesizing OpenAlex, Semantic Scholar, ScienceDirect, and YouTube.*");
        sb.AppendLine();

        var groups = bookmarks.GroupBy(b => b.Field).OrderBy(g => g.Key.ToString());
        foreach (var group in groups)
        {
            sb.AppendLine($"## Subject Course: {group.Key}");
            sb.AppendLine();

            foreach (var item in group)
            {
                sb.AppendLine($"### {item.Title}");
                sb.AppendLine($"- **Authors / Publisher:** {item.AuthorOrPublisher}");
                if (item.PublishedDate.HasValue)
                {
                    sb.AppendLine($"- **Publication Date:** {item.PublishedDate.Value:yyyy-MM-dd}");
                }
                sb.AppendLine($"- **Corpus:** {item.Platform} • *{item.MetricsInfo}*");
                sb.AppendLine($"- **Reference Link:** {item.Url}");

                if (item.Metadata.TryGetValue("PdfUrl", out var pdfUrl) && !string.IsNullOrWhiteSpace(pdfUrl))
                {
                    sb.AppendLine($"- **Direct PDF:** {pdfUrl}");
                }

                var apa = CitationFormatter.Format(item, CitationStyle.Apa7);
                sb.AppendLine($"- **APA Citation:** {apa}");

                if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    sb.AppendLine();
                    sb.AppendLine($"**Abstract / Core Synopsis:**");
                    sb.AppendLine($"> {item.Description}");
                }

                if (item.Metadata.TryGetValue("VideoId", out var videoId) && !string.IsNullOrWhiteSpace(videoId))
                {
                    try
                    {
                        var notes = await JS.InvokeAsync<string>("isourcekoStorage.getVideoNotes", videoId);
                        if (!string.IsNullOrWhiteSpace(notes))
                        {
                            sb.AppendLine();
                            sb.AppendLine($"**Personal Lecture Scratchpad Notes:**");
                            sb.AppendLine("```text");
                            sb.AppendLine(notes.Trim());
                            sb.AppendLine("```");
                        }
                    }
                    catch { }
                }

                sb.AppendLine();
                sb.AppendLine("---");
                sb.AppendLine();
            }
        }

        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.downloadTextFile", "isourceko-study-syllabus.md", sb.ToString());
            isGuideExported = true;
            StateHasChanged();
            await Task.Delay(2000);
            isGuideExported = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ExportJsonBackup()
    {
        if (!bookmarks.Any()) return;

        Dictionary<string, string> videoNotes = new();
        try
        {
            videoNotes = await JS.InvokeAsync<Dictionary<string, string>>("isourcekoStorage.getAllVideoNotes") ?? new();
        }
        catch { }

        var bundle = new BookmarkBackupBundle
        {
            ExportedAt = DateTime.UtcNow,
            Bookmarks = bookmarks.ToList(),
            VideoNotes = videoNotes
        };

        var json = JsonSerializer.Serialize(bundle, BackupJsonOptions);
        var filename = $"isourceko-syllabus-{DateTime.Now:yyyy-MM-dd}.json";

        try
        {
            await JS.InvokeVoidAsync("isourcekoStorage.downloadTextFile", filename, json);
            isJsonExported = true;
            StateHasChanged();
            await Task.Delay(2000);
            isJsonExported = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task HandleJsonFileSelected(InputFileChangeEventArgs e)
    {
        importErrorMessage = null;
        importSuccessMessage = null;
        pendingImportBundle = null;

        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            importErrorMessage = "Backup file exceeds the 5MB limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var rawJson = await reader.ReadToEndAsync();

            var bundle = TryParseBackupJson(rawJson);
            if (bundle == null || (bundle.Bookmarks.Count == 0 && bundle.VideoNotes.Count == 0))
            {
                importErrorMessage = "The selected JSON file does not contain any valid ISourceKO saved sources or lecture notes.";
                return;
            }

            pendingImportBundle = bundle;
            pendingImportFileName = file.Name;
            replaceOnImport = false;
        }
        catch (JsonException)
        {
            importErrorMessage = "Invalid JSON syntax. Please upload an unmodified ISourceKO .json backup file.";
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Could not read backup file: {ex.Message}";
        }
    }

    private static BookmarkBackupBundle? TryParseBackupJson(string rawJson)
    {
        if (string.IsNullOrWhiteSpace(rawJson)) return null;

        var trimmed = rawJson.TrimStart();
        if (trimmed.StartsWith("["))
        {
            var rawList = JsonSerializer.Deserialize<List<SourceItem>>(rawJson, BackupJsonOptions);
            return rawList == null ? null : new BookmarkBackupBundle { Bookmarks = rawList };
        }

        var bundle = JsonSerializer.Deserialize<BookmarkBackupBundle>(rawJson, BackupJsonOptions);
        if (bundle != null)
        {
            bundle.Bookmarks ??= new List<SourceItem>();
            bundle.VideoNotes ??= new Dictionary<string, string>();
        }
        return bundle;
    }

    private async Task ConfirmJsonImport()
    {
        if (pendingImportBundle == null || isImporting) return;
        isImporting = true;
        importErrorMessage = null;

        try
        {
            var result = await BookmarkService.ImportBookmarksAsync(pendingImportBundle.Bookmarks, replaceOnImport);
            var restoredNotes = 0;

            if (pendingImportBundle.VideoNotes.Count > 0 || replaceOnImport)
            {
                try
                {
                    restoredNotes = await JS.InvokeAsync<int>("isourcekoStorage.importVideoNotes", pendingImportBundle.VideoNotes, replaceOnImport);
                }
                catch { }
            }

            LoadBookmarks();
            selectedField = null;
            pendingImportBundle = null;
            pendingImportFileName = null;

            var duplicateMsg = result.SkippedDuplicates > 0 ? $" ({result.SkippedDuplicates} duplicate(s) skipped)" : string.Empty;
            importSuccessMessage = $"Imported {result.AddedCount} source(s) and {restoredNotes} lecture note(s){duplicateMsg}.";
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private void CancelJsonImport()
    {
        pendingImportBundle = null;
        pendingImportFileName = null;
    }

    private async Task ConfirmClearAll()
    {
        confirmClearAll = false;
        await BookmarkService.ClearAllBookmarksAsync();
        selectedField = null;
        LoadBookmarks();
        importSuccessMessage = "Cleared all saved bookmarks from this browser.";
    }

    private async Task OpenStudyNoteModal(SourceItem item)
    {
        var loaded = await SubmissionService.GetByIdAsync(item.Id);
        if (loaded != null)
        {
            activeStudyNote = loaded;
            return;
        }

        var isSystem = item.Metadata.TryGetValue("IsSystemGenerated", out var sysVal) &&
                       string.Equals(sysVal, "true", StringComparison.OrdinalIgnoreCase);

        var fallback = new StudentSubmission
        {
            Id = item.Id,
            Title = item.Title,
            Description = item.Description,
            Field = item.Field,
            StudentName = isSystem ? "ISource Gen" : item.AuthorOrPublisher,
            SubmittedAt = item.PublishedDate ?? DateTime.UtcNow,
            Tags = item.Tags,
            IsSystemGenerated = isSystem
        };
        StudyNoteGeneratorService.EnsureHydrated(fallback);
        activeStudyNote = fallback;
    }

    private void CloseStudyNoteModal() => activeStudyNote = null;
    private void OpenVideoModal(SourceItem item) => activeVideoItem = item;
    private void CloseVideoModal() => activeVideoItem = null;
    private void OpenPdfModal(SourceItem item) => activePdfItem = item;
    private void ClosePdfModal() => activePdfItem = null;
    private void OpenCitationModal(SourceItem item) => activeCitationItem = item;
    private void CloseCitationModal() => activeCitationItem = null;

    public void Dispose()
    {
        BookmarkService.OnBookmarksChanged -= HandleBookmarksChanged;
    }
}
