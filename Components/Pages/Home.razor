@page "/"
@rendermode InteractiveServer
@using ISourceKO.Services
@inject ISourceAggregatorService AggregatorService
@inject IBookmarkService BookmarkService
@inject IStudentSubmissionService SubmissionService
@inject IJSRuntime JS

<PageTitle>ISourceKO — Academic Discovery Across Literature, Lectures & Notes</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Hero Section with Staggered Masked Text Reveal & Scale-Down Media -->
    <header class="relative text-center max-w-3xl mx-auto mb-10 py-8 px-5 rounded-2xl hero-blueprint border border-oxford-200/60 bg-white/50 shadow-subtle hero-media-scale overflow-hidden">
        <!-- Masked Reveal Line 1: Badge -->
        <div class="overflow-hidden">
            <span class="masked-line-inner inline-flex items-center gap-2 px-3 py-1 rounded text-xs font-bold bg-oxford-950 text-bone shadow-subtle mb-3 will-change-transform">
                <span class="w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
                Unified Collegiate Research Engine
            </span>
        </div>

        <!-- Masked Reveal Line 2: Headline Part 1 -->
        <div class="overflow-hidden">
            <h1 class="masked-line-inner font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-oxford-950 tracking-tight leading-[1.12] will-change-transform">
                One Search Across Scholarly Papers,
            </h1>
        </div>

        <!-- Masked Reveal Line 3: Headline Part 2 -->
        <div class="overflow-hidden">
            <h1 class="masked-line-inner font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-oxford-950 tracking-tight leading-[1.12] text-oxford-800 will-change-transform">
                Lecture Videos, and Student Notes
            </h1>
        </div>

        <!-- Masked Reveal Line 4: Body Description -->
        <div class="overflow-hidden mt-3">
            <p class="masked-line-inner text-xs sm:text-sm text-oxford-600 max-w-2xl mx-auto leading-relaxed will-change-transform">
                Consolidate your collegiate research. Query live OpenAlex papers, arXiv STEM preprints, PubMed medical research, Semantic Scholar citations, Crossref DOIs, ScienceDirect journals, YouTube lectures, and student notes in a single pass.
            </p>
        </div>
    </header>

    <!-- Interactive Search Desk (With Magnetic Action Button) -->
    <section class="max-w-4xl mx-auto mb-10" aria-label="Search form">
        <SearchBar Query="searchQuery" TrendingTopics="trendingTopics" OnSearch="PerformSearch" />
    </section>

    <!-- Kinetic Marquee: Reacts to User's Scroll Velocity & Direction -->
    <section class="w-full overflow-hidden py-3 border-y border-oxford-200/70 bg-white/70 backdrop-blur-sm my-8 select-none" aria-hidden="true">
        <div class="kinetic-marquee-track flex whitespace-nowrap will-change-transform text-[11px] font-mono font-bold tracking-widest text-oxford-600 uppercase">
            <span>OPENALEX 250M+ PAPERS &nbsp;•&nbsp; ARXIV STEM PREPRINTS &nbsp;•&nbsp; PUBMED / NCBI HEALTH SCIENCES &nbsp;•&nbsp; IN-APP YOUTUBE LECTURE THEATER &nbsp;•&nbsp; SEMANTIC SCHOLAR GRAPH &nbsp;•&nbsp; CROSSREF DOI REGISTRY &nbsp;•&nbsp; SCIENCEDIRECT JOURNALS &nbsp;•&nbsp; APA / MLA / CHICAGO / BIBTEX &nbsp;•&nbsp; SQLITE STUDENT ARCHIVE &nbsp;•&nbsp; </span>
            <span>OPENALEX 250M+ PAPERS &nbsp;•&nbsp; ARXIV STEM PREPRINTS &nbsp;•&nbsp; PUBMED / NCBI HEALTH SCIENCES &nbsp;•&nbsp; IN-APP YOUTUBE LECTURE THEATER &nbsp;•&nbsp; SEMANTIC SCHOLAR GRAPH &nbsp;•&nbsp; CROSSREF DOI REGISTRY &nbsp;•&nbsp; SCIENCEDIRECT JOURNALS &nbsp;•&nbsp; APA / MLA / CHICAGO / BIBTEX &nbsp;•&nbsp; SQLITE STUDENT ARCHIVE &nbsp;•&nbsp; </span>
        </div>
    </section>

    <!-- Results Section (Dynamic Animated Flow) -->
    <section class="max-w-7xl mx-auto reveal-on-scroll" aria-live="polite">
        @if (isLoading)
        {
            <div class="py-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-2 text-xs text-oxford-600 font-mono font-medium">
                        <span class="w-2 h-2 rounded-full bg-flame animate-ping"></span>
                        Executing parallel queries across OpenAlex, arXiv, PubMed, Semantic Scholar, Crossref, ScienceDirect, YouTube and Student Archive...
                    </span>
                </div>
                <LoadingSkeleton Count="6" />
            </div>
        }
        else if (response != null && !string.IsNullOrWhiteSpace(response.Query))
        {
            <!-- Results Header & Counts with Pop Pills -->
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 pb-3 mb-4 border-b border-oxford-200">
                <div>
                    <h2 class="font-serif text-xl font-bold text-oxford-950">
                        Results for "<span class="text-oxford-900 italic font-semibold">@response.Query</span>"
                    </h2>
                    <p class="text-xs text-oxford-500 mt-0.5">
                        Retrieved <strong class="text-oxford-900 font-mono">@response.TotalResults</strong> entries in <strong class="text-flame font-mono">@(Math.Round(response.ElapsedTime.TotalMilliseconds))ms</strong> across @response.CountByPlatform.Count corpora
                    </p>
                </div>

                <!-- Platform Count Pills with Tactile Border -->
                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                    @foreach (var kvp in response.CountByPlatform.Where(k => k.Value > 0))
                    {
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-white border border-oxford-200 rounded shadow-subtle text-oxford-700 font-medium text-[11px]">
                            <PlatformBadge Platform="kvp.Key" />
                            <span class="font-mono font-bold text-oxford-900">@kvp.Value</span>
                        </span>
                    }
                </div>
            </div>

            <!-- PROPER FACETED FILTERING SECTION (Research Paper Priority, Category Dossiers, Date & Open Access) -->
            <div class="mb-6 p-4 bg-white/80 backdrop-blur-sm rounded-xl border border-oxford-200 shadow-subtle flex flex-col gap-3">
                <!-- Top Row: Primary Category Dossiers Tabs -->
                <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-oxford-100">
                    <div class="inline-flex items-center p-1 rounded-lg bg-oxford-100/80 border border-oxford-200 text-xs font-semibold" role="tablist">
                        <button type="button"
                                @onclick="() => FilterByCategory(ResourceCategory.All)"
                                class="px-3 py-1.5 rounded-md text-xs transition-all @(currentCategory == ResourceCategory.All ? "bg-oxford-950 text-bone shadow-subtle font-bold" : "text-oxford-600 hover:text-oxford-900")">
                            All Resources (@response.TotalResults)
                        </button>
                        <button type="button"
                                @onclick="() => FilterByCategory(ResourceCategory.ScholarlyPapers)"
                                class="px-3 py-1.5 rounded-md text-xs transition-all flex items-center gap-1.5 @(currentCategory == ResourceCategory.ScholarlyPapers ? "bg-academic text-white shadow-subtle font-bold" : "text-oxford-600 hover:text-academic")">
                            <span>Scholarly Papers</span>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono @(currentCategory == ResourceCategory.ScholarlyPapers ? "bg-white/20 text-white" : "bg-academic-light text-academic")">@response.PapersCount</span>
                        </button>
                        <button type="button"
                                @onclick="() => FilterByCategory(ResourceCategory.LectureVideos)"
                                class="px-3 py-1.5 rounded-md text-xs transition-all flex items-center gap-1.5 @(currentCategory == ResourceCategory.LectureVideos ? "bg-youtube text-white shadow-subtle font-bold" : "text-oxford-600 hover:text-youtube")">
                            <span>Lecture Videos</span>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono @(currentCategory == ResourceCategory.LectureVideos ? "bg-white/20 text-white" : "bg-youtube-light text-youtube")">@response.VideosCount</span>
                        </button>
                        <button type="button"
                                @onclick="() => FilterByCategory(ResourceCategory.StudentNotes)"
                                class="px-3 py-1.5 rounded-md text-xs transition-all flex items-center gap-1.5 @(currentCategory == ResourceCategory.StudentNotes ? "bg-evergreen text-white shadow-subtle font-bold" : "text-oxford-600 hover:text-evergreen")">
                            <span>Student Notes</span>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono @(currentCategory == ResourceCategory.StudentNotes ? "bg-white/20 text-white" : "bg-evergreen-light text-evergreen")">@response.NotesCount</span>
                        </button>
                    </div>

                    <!-- Sort Order Selector -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold text-oxford-500">Sort:</span>
                        <select value="@currentSortBy" @onchange="OnSortChanged" class="py-1 px-2.5 bg-bone border border-oxford-200 rounded text-oxford-800 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-oxford-950 cursor-pointer">
                            <option value="scholarly">Scholarly Priority (Papers First)</option>
                            <option value="date">Most Recent</option>
                            <option value="citations">Most Cited / High Impact</option>
                            <option value="relevance">Corpus Relevance</option>
                        </select>
                    </div>
                </div>

                <!-- Bottom Row: Multi-Facet Filters (Open Access PDF & Date Recency) -->
                <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
                    <div class="flex flex-wrap items-center gap-3">
                        <!-- Open Access PDF Toggle -->
                        <button type="button"
                                @onclick="ToggleOpenAccessPdf"
                                class="btn-press inline-flex items-center gap-1.5 px-3 py-1 rounded-md border text-xs font-semibold transition-all @(isOpenAccessOnly ? "bg-emerald-600 text-white border-emerald-700 shadow-subtle" : "bg-oxford-50 text-oxford-700 border-oxford-200 hover:bg-oxford-100")">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <span>Open Access PDF Only</span>
                            @if (isOpenAccessOnly)
                            {
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            }
                        </button>

                        <!-- Recency Quick Filter -->
                        <div class="inline-flex items-center gap-1">
                            <span class="text-oxford-500 text-[11px] font-semibold mr-1">Publication:</span>
                            <button type="button"
                                    @onclick="() => FilterByDateRange(DateRangeFilter.AnyTime)"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium transition-all @(currentDateRange == DateRangeFilter.AnyTime ? "bg-oxford-900 text-white" : "text-oxford-600 hover:text-oxford-900")">
                                Any Time
                            </button>
                            <button type="button"
                                    @onclick="() => FilterByDateRange(DateRangeFilter.PastYear)"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium transition-all @(currentDateRange == DateRangeFilter.PastYear ? "bg-oxford-900 text-white" : "text-oxford-600 hover:text-oxford-900")">
                                Past Year
                            </button>
                            <button type="button"
                                    @onclick="() => FilterByDateRange(DateRangeFilter.PastThreeYears)"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium transition-all @(currentDateRange == DateRangeFilter.PastThreeYears ? "bg-oxford-900 text-white" : "text-oxford-600 hover:text-oxford-900")">
                                Past 3 Years
                            </button>
                            <button type="button"
                                    @onclick="() => FilterByDateRange(DateRangeFilter.PastFiveYears)"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium transition-all @(currentDateRange == DateRangeFilter.PastFiveYears ? "bg-oxford-900 text-white" : "text-oxford-600 hover:text-oxford-900")">
                                Past 5 Years
                            </button>
                        </div>
                    </div>

                    @if (HasActiveFilters)
                    {
                        <button type="button"
                                @onclick="ResetFilters"
                                class="text-xs text-flame hover:underline font-semibold flex items-center gap-1">
                            <span>Reset Filters</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }

                    @if (response.Items.Any())
                    {
                        <button type="button"
                                @onclick="OpenResearchAssistant"
                                class="btn-press inline-flex items-center gap-1.5 px-3 py-1 bg-oxford-950 hover:bg-oxford-800 text-bone text-xs font-bold rounded shadow-subtle transition-all">
                            <span>Ask Sources (AI)</span>
                        </button>
                    }
                </div>
            </div>

            @if (response.Items.Any())
            {
                <!-- Delineated Results Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
                    @foreach (var item in response.Items)
                    {
                        <SourceCard Item="item"
                                    OnWatchVideo="OpenVideoModal"
                                    OnReadPdf="OpenPdfModal"
                                    OnReadNote="OpenStudyNoteModal"
                                    OnOpenCitation="OpenCitationModal" />
                    }
                </div>

                @if (response.HasMore)
                {
                    <div class="mt-10 mb-6 flex flex-col items-center justify-center gap-2">
                        <button type="button"
                                @onclick="LoadMoreSources"
                                disabled="@isLoadingMore"
                                class="btn-press inline-flex items-center gap-2.5 px-6 py-3 rounded-lg bg-white hover:bg-oxford-50 text-oxford-900 border border-oxford-300 hover:border-oxford-500 font-semibold text-xs shadow-subtle hover:shadow-pop transition-all disabled:opacity-60 disabled:cursor-not-allowed">
                            @if (isLoadingMore)
                            {
                                <span class="w-3.5 h-3.5 border-2 border-oxford-400 border-t-flame rounded-full animate-spin"></span>
                                <span>Retrieving more sources...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-flame" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                                <span>Load More Sources (Showing @response.TotalResults)</span>
                            }
                        </button>
                        <span class="text-[11px] font-mono text-oxford-500">
                            Page @currentPage loaded • OpenAlex, arXiv, PubMed, Semantic Scholar, Crossref, ScienceDirect & YouTube
                        </span>
                    </div>
                }
                else if (response.Items.Count > 0)
                {
                    <div class="mt-8 text-center text-[11px] font-mono text-oxford-500">
                        • End of indexed scholarly results for this query •
                    </div>
                }
            }
            else
            {
                <EmptyState Title="No indexed sources found" Message="Try adjusting your filter criteria, broadening your query keywords, or deselecting 'Open Access PDF Only'." />
            }
        }
        else
        {
            <!-- Scroll-Linked Sticky Split-Screen Section: How ISourceKO Works -->
            <div class="pt-8 pb-12 reveal-on-scroll">
                <div class="text-center mb-10">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-bold bg-oxford-100 text-oxford-800 uppercase tracking-wider mb-2">
                        System Architecture
                    </span>
                    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950">How ISourceKO Indexes Knowledge</h2>
                    <p class="text-xs sm:text-sm text-oxford-600 mt-1 max-w-lg mx-auto">
                        Scroll through the knowledge pipeline below to see how live academic APIs, distraction-free media, and SQLite peer archives synchronize in real-time.
                    </p>
                </div>

                <!-- Sticky Split Container (Desktop Pinned Parallax, Mobile Vertical Stack) -->
                <div class="sticky-split-container grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <!-- Left: Dynamic Sticky Visual Terminal/Display Container -->
                    <div class="lg:col-span-5 lg:sticky lg:top-24 bg-oxford-950 text-bone p-6 rounded-2xl shadow-lift border border-oxford-800 space-y-4">
                        <div class="flex items-center justify-between pb-3 border-b border-oxford-800 text-xs">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                <span class="font-mono text-oxford-400 text-[11px] ml-1">corpus_telemetry.log</span>
                            </div>
                            <span class="px-2 py-0.5 rounded bg-flame/20 text-flame font-mono text-[10px] font-bold">LIVE SYNC</span>
                        </div>

                        <!-- Panel 1: Video Stream State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-red-400">[01] In-App YouTube Lecture Theater</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Watch lectures in a distraction-free embedded player with a local study scratchpad, citation export, and one-click syllabus bookmarking.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Embed: No-Cookie HD</span>
                                    <span class="text-emerald-400">STATUS: 200 OK</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 2: Live Academic Connector State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-teal-400">[02] Live Multi-Corpus Scholarly Network</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Harvest live papers across OpenAlex, arXiv preprints, PubMed NCBI, Semantic Scholar, Crossref DOIs, and ScienceDirect with instant abstract parsing.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Connectors: 7 Live Streams</span>
                                    <span class="text-emerald-400">SYNC: Active</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 3: SQLite Peer Archive State -->
                        <div class="split-visual-panel transition-all">
                            <div class="p-4 rounded-xl bg-oxford-900 border border-oxford-800 space-y-2">
                                <span class="text-xs font-mono font-bold text-emerald-400">[03] SQLite-Persisted Community Knowledge</span>
                                <p class="text-xs text-oxford-300 leading-relaxed">
                                    Access peer-submitted lecture notes, study guides, and campus discussions persisted with Entity Framework Core and full-text search.
                                </p>
                                <div class="pt-2 flex items-center justify-between font-mono text-[11px] text-oxford-400">
                                    <span>Database: SQLite WAL</span>
                                    <span class="text-emerald-400">STORAGE: Mounted</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Narrative Scroll Story Steps -->
                    <div class="lg:col-span-7 space-y-8">
                        <div class="p-6 md:p-8 rounded-2xl bg-white border border-oxford-200/90 shadow-subtle hover:shadow-lift transition-all">
                            <span class="inline-block px-2.5 py-1 rounded bg-red-100 text-red-700 font-mono text-xs font-bold mb-3">STEP 01</span>
                            <h3 class="font-serif text-xl sm:text-2xl font-bold text-oxford-950 mb-2">Curated Collegiate Media Stream</h3>
                            <p class="text-xs sm:text-sm text-oxford-600 leading-relaxed">
                                Search university channels, conference talks, and specialized course playlists. Watch inline without autoplay or algorithmic distractions, using our integrated lecture scratchpad with real-time markdown formatting.
                            </p>
                        </div>

                        <div class="p-6 md:p-8 rounded-2xl bg-white border border-oxford-200/90 shadow-subtle hover:shadow-lift transition-all">
                            <span class="inline-block px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold mb-3">STEP 02</span>
                            <h3 class="font-serif text-xl sm:text-2xl font-bold text-oxford-950 mb-2">Multi-Corpus Scholarly Synthesis</h3>
                            <p class="text-xs sm:text-sm text-oxford-600 leading-relaxed">
                                Simultaneously query 250M+ open access publications from OpenAlex, STEM preprints on arXiv, medical literature on PubMed, citation graphs on Semantic Scholar, and registered DOIs on Crossref with scholarly prioritization.
                            </p>
                        </div>

                        <div class="p-6 md:p-8 rounded-2xl bg-white border border-oxford-200/90 shadow-subtle hover:shadow-lift transition-all">
                            <span class="inline-block px-2.5 py-1 rounded bg-emerald-100 text-emerald-800 font-mono text-xs font-bold mb-3">STEP 03</span>
                            <h3 class="font-serif text-xl sm:text-2xl font-bold text-oxford-950 mb-2">Persistent Peer Contributions</h3>
                            <p class="text-xs sm:text-sm text-oxford-600 leading-relaxed">
                                Bookmark sources to your local client session and contribute your own course notes, cheat sheets, or recommended links to the shared student archive with full community upvoting and peer discussion.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>

    <!-- Modals -->
    <VideoPlayerModal Item="activeVideoItem" OnClose="CloseVideoModal" />
    <PdfViewerModal Item="activePdfItem" OnClose="ClosePdfModal" />
    <CitationModal Item="activeCitationItem" OnClose="CloseCitationModal" />
    <StudyNoteModal Note="activeStudyNote" OnClose="CloseStudyNoteModal" />
    <ResearchAssistantModal IsOpen="isAssistantOpen"
                            Sources="response?.Items ?? new List<SourceItem>()"
                            OnClose="CloseResearchAssistant" />
</div>

@code {
    private SearchQuery searchQuery = new();
    private SearchQuery? currentQuery;
    private SearchResponse? response;
    private List<string> trendingTopics = new();
    private bool isLoading = false;
    private bool isLoadingMore = false;
    private int currentPage = 1;

    private ResourceCategory currentCategory = ResourceCategory.All;
    private DateRangeFilter currentDateRange = DateRangeFilter.AnyTime;
    private bool isOpenAccessOnly = false;
    private string currentSortBy = "scholarly";

    private SourceItem? activeVideoItem;
    private SourceItem? activePdfItem;
    private SourceItem? activeCitationItem;
    private StudentSubmission? activeStudyNote;
    private bool isAssistantOpen = false;

    private bool HasActiveFilters =>
        currentCategory != ResourceCategory.All ||
        currentDateRange != DateRangeFilter.AnyTime ||
        isOpenAccessOnly ||
        currentSortBy != "scholarly";

    protected override async Task OnInitializedAsync()
    {
        trendingTopics = await AggregatorService.GetTrendingTopicsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientId = await JS.InvokeAsync<string>("isourcekoStorage.getOrCreateClientId");
                await BookmarkService.InitializeClientAsync(clientId);
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task PerformSearch(SearchQuery query)
    {
        if (string.IsNullOrWhiteSpace(query.QueryText))
        {
            response = null;
            currentQuery = null;
            return;
        }

        isLoading = true;
        currentPage = 1;
        currentQuery = new SearchQuery
        {
            QueryText = query.QueryText,
            Field = query.Field,
            Platform = query.Platform,
            Category = currentCategory,
            DateRange = currentDateRange,
            OpenAccessOnly = isOpenAccessOnly,
            SortBy = currentSortBy,
            PageNumber = 1
        };
        StateHasChanged();

        try
        {
            response = await AggregatorService.AggregateSearchAsync(currentQuery);
            trendingTopics = await AggregatorService.GetTrendingTopicsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByCategory(ResourceCategory category)
    {
        if (currentCategory == category) return;
        currentCategory = category;

        if (currentQuery != null)
        {
            currentQuery.Category = currentCategory;
            currentQuery.PageNumber = 1;
            currentPage = 1;
            await ReExecuteSearch();
        }
    }

    private async Task ToggleOpenAccessPdf()
    {
        isOpenAccessOnly = !isOpenAccessOnly;
        if (currentQuery != null)
        {
            currentQuery.OpenAccessOnly = isOpenAccessOnly;
            currentQuery.PageNumber = 1;
            currentPage = 1;
            await ReExecuteSearch();
        }
    }

    private async Task FilterByDateRange(DateRangeFilter range)
    {
        if (currentDateRange == range) return;
        currentDateRange = range;
        if (currentQuery != null)
        {
            currentQuery.DateRange = currentDateRange;
            currentQuery.PageNumber = 1;
            currentPage = 1;
            await ReExecuteSearch();
        }
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        currentSortBy = e.Value?.ToString() ?? "scholarly";
        if (currentQuery != null)
        {
            currentQuery.SortBy = currentSortBy;
            currentQuery.PageNumber = 1;
            currentPage = 1;
            await ReExecuteSearch();
        }
    }

    private async Task ResetFilters()
    {
        currentCategory = ResourceCategory.All;
        currentDateRange = DateRangeFilter.AnyTime;
        isOpenAccessOnly = false;
        currentSortBy = "scholarly";

        if (currentQuery != null)
        {
            currentQuery.Category = ResourceCategory.All;
            currentQuery.DateRange = DateRangeFilter.AnyTime;
            currentQuery.OpenAccessOnly = false;
            currentQuery.SortBy = "scholarly";
            currentQuery.PageNumber = 1;
            currentPage = 1;
            await ReExecuteSearch();
        }
    }

    private async Task ReExecuteSearch()
    {
        if (currentQuery == null) return;
        isLoading = true;
        StateHasChanged();

        try
        {
            response = await AggregatorService.AggregateSearchAsync(currentQuery);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreSources()
    {
        if (isLoadingMore || currentQuery == null || response == null) return;
        isLoadingMore = true;
        StateHasChanged();

        try
        {
            currentPage++;
            currentQuery.PageNumber = currentPage;
            var next = await AggregatorService.AggregateSearchAsync(currentQuery);
            if (next.Items.Count > 0)
            {
                var existingIds = response.Items.Select(x => x.Id).ToHashSet();
                var newItems = next.Items.Where(x => !existingIds.Contains(x.Id)).ToList();
                response.Items.AddRange(newItems);

                foreach (var kvp in next.CountByPlatform)
                {
                    response.CountByPlatform[kvp.Key] = response.CountByPlatform.GetValueOrDefault(kvp.Key) + kvp.Value;
                }

                response.PapersCount += next.PapersCount;
                response.VideosCount += next.VideosCount;
                response.NotesCount += next.NotesCount;

                response.HasMore = newItems.Count > 0 && next.HasMore;
            }
            else
            {
                response.HasMore = false;
            }
        }
        catch
        {
            response.HasMore = false;
        }
        finally
        {
            isLoadingMore = false;
            StateHasChanged();
        }
    }

