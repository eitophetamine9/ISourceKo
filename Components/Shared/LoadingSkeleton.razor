<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 animate-pulse">
    @for (int i = 0; i < Count; i++)
    {
        <div class="bg-white rounded-xl border border-slate-200/80 p-5 space-y-4">
            <div class="flex justify-between items-center">
                <div class="h-5 w-24 bg-slate-200 rounded-full"></div>
                <div class="h-4 w-12 bg-slate-100 rounded"></div>
            </div>
            <div class="h-5 bg-slate-200 rounded w-3/4"></div>
            <div class="space-y-2">
                <div class="h-3.5 bg-slate-100 rounded"></div>
                <div class="h-3.5 bg-slate-100 rounded w-5/6"></div>
            </div>
            <div class="pt-3 border-t border-slate-100 flex justify-between items-center">
                <div class="h-3.5 w-28 bg-slate-200 rounded"></div>
                <div class="h-3.5 w-16 bg-slate-200 rounded"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 6;
}
