@page "/Error"
@layout MainLayout
@using System.Diagnostics

<PageTitle>System Error — ISourceKO</PageTitle>

<div class="max-w-lg mx-auto text-center py-20 px-4">
    <div class="w-12 h-12 mx-auto mb-4 rounded-lg bg-red-50 flex items-center justify-center text-youtube border border-red-200 shadow-subtle">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
    </div>

    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-red-50 text-youtube border border-red-200 uppercase tracking-wider mb-2">
        500 • Archive Interrupted
    </span>

    <h1 class="font-serif text-2xl sm:text-3xl font-bold text-oxford-950 tracking-tight">
        Something went wrong while loading this record
    </h1>

    <p class="mt-2 text-xs sm:text-sm text-oxford-600 leading-relaxed">
        An unexpected server error interrupted your request. Please retry or return to the search hub.
    </p>

    @if (ShowRequestId)
    {
        <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded bg-bone border border-oxford-200 text-[11px] font-mono text-oxford-600">
            <span class="text-oxford-400">Request ID:</span>
            <code class="text-oxford-900 font-semibold">@RequestId</code>
        </div>
    }

    <div class="mt-6 flex items-center justify-center gap-3">
        <a href="" class="btn-flame inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs font-semibold shadow-subtle">
            Return to Search Hub
        </a>
        <a href="community" class="btn-press inline-flex items-center gap-1.5 px-4 py-2 bg-white hover:bg-oxford-50 text-oxford-800 border border-oxford-200 rounded text-xs font-semibold">
            Browse Peer Archive
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
