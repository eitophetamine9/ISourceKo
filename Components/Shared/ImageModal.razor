@if (!string.IsNullOrEmpty(ImageUrl))
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-oxford-950/80 backdrop-blur-sm animate-fade-in"
         @onclick="Close">
        <div class="relative max-w-4xl max-h-[90vh] bg-white rounded overflow-hidden shadow-lift border border-oxford-700 flex flex-col animate-scale-in"
             @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="px-5 py-3 bg-oxford-950 text-bone flex items-center justify-between border-b border-oxford-800">
                <span class="text-xs font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 text-evergreen-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    Student Note Archive Preview
                </span>
                <button type="button" @onclick="Close" class="btn-press text-oxford-400 hover:text-bone transition-colors p-1" aria-label="Close modal">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Image Viewport -->
            <div class="p-2 bg-oxford-950/90 flex items-center justify-center overflow-auto max-h-[75vh]">
                <img src="@ImageUrl" alt="Note preview" class="max-w-full max-h-full object-contain rounded shadow" />
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-3 bg-white border-t border-oxford-200 flex items-center justify-between text-xs text-oxford-600">
                <span>Archived student study document</span>
                <a href="@ImageUrl" target="_blank" download class="btn-press inline-flex items-center gap-1.5 text-oxford-900 font-semibold hover:underline">
                    <span>Download Original</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
